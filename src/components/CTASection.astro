---
import Button from './Button.astro';
import Marker from './Marker.astro';

interface Props {
  heading: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  marker?: { idx: string; label: string; count: string };
}
const {
  heading,
  body,
  primaryLabel = 'Book a consultation',
  primaryHref = '/contact/',
  secondaryLabel,
  secondaryHref,
  marker,
} = Astro.props;
---
<section class="py-14 sm:py-[88px]">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    {marker && <Marker idx={marker.idx} label={marker.label} count={marker.count} />}
    <div class="cta-band bg-ink rounded-[20px] px-6 py-11 sm:px-[52px] sm:py-16 relative overflow-hidden" data-reveal>
      <div class="max-w-[600px] mx-auto text-center relative z-[1]">
        <h2 class="font-display font-extrabold text-[clamp(1.9rem,3.8vw,2.8rem)] leading-[1.1] tracking-[-0.03em] text-white mb-4">
          {heading}
        </h2>
        {body && (
          <p class="text-[15.5px] text-[#B9B4C9] leading-[1.65] mb-8">
            {body}
          </p>
        )}
        <div class="flex flex-wrap justify-center items-center gap-4">
          <Button href={primaryHref} variant="primary" magnetic>{primaryLabel}</Button>
          {secondaryHref && secondaryLabel && (
            <Button href={secondaryHref} variant="outlineDark">{secondaryLabel}</Button>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -60px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251, 150, 31, 0.16) 0%, transparent 70%);
  }
</style>
