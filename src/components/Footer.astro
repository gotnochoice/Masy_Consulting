---
import Logo from './Logo.astro';
import { siteMeta } from '../data/site';

const year = new Date().getFullYear();
---
<footer id="contact" class="bg-white border-t border-line scroll-mt-24">
  <div class="max-w-content mx-auto px-5 sm:px-8 pt-[52px] pb-9">
    <div class="grid grid-cols-2 md:grid-cols-[1.3fr_1fr_1fr_1fr] gap-8 mb-8 pb-8 border-b border-line">
      <div class="col-span-2 md:col-span-1">
        <Logo size="sm" class="mb-3" />
        <p class="text-[13px] text-slate leading-relaxed max-w-[280px]">
          Masy Consulting Limited, RC No. 8189749. A separate brand from Masy Academy, our tutoring business.
        </p>
      </div>

      <div>
        <h5 class="text-[11.5px] font-bold uppercase tracking-[0.06em] text-slate-light mb-3">What we run</h5>
        <ul class="space-y-2 text-[14px] text-ink font-medium">
          <li><a href="/#groups" class="hover:text-indigo transition-colors">Your team</a></li>
          <li><a href="/#groups" class="hover:text-indigo transition-colors">What goes out the door</a></li>
          <li><a href="/#examples" class="hover:text-indigo transition-colors">Examples</a></li>
        </ul>
      </div>

      <div>
        <h5 class="text-[11.5px] font-bold uppercase tracking-[0.06em] text-slate-light mb-3">Company</h5>
        <ul class="space-y-2 text-[14px] text-ink font-medium">
          <li><a href="/#about" class="hover:text-indigo transition-colors">Who we are</a></li>
          <li><a href="/#process" class="hover:text-indigo transition-colors">Approach</a></li>
          <li><a href="/insights/" class="hover:text-indigo transition-colors">Insights</a></li>
          <li><a href="/careers/" class="hover:text-indigo transition-colors">Careers</a></li>
          <li><a href="/#book" class="hover:text-indigo transition-colors">Book a call</a></li>
        </ul>
      </div>

      <div>
        <h5 class="text-[11.5px] font-bold uppercase tracking-[0.06em] text-slate-light mb-3">Reach us</h5>
        <ul class="space-y-2 text-[14px] text-ink font-medium">
          <li><a href={`mailto:${siteMeta.email}`} class="hover:text-indigo transition-colors">{siteMeta.email}</a></li>
          <li>
            <a href={siteMeta.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-indigo transition-colors">
              {siteMeta.whatsappDisplay}
            </a>
          </li>
        </ul>
        <div class="flex items-center gap-3 mt-4">
          <a href={siteMeta.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Masy Consulting on LinkedIn" class="text-ink/60 hover:text-indigo transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-[18px] h-[18px]" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
            </svg>
          </a>
          <a href={siteMeta.instagram} target="_blank" rel="noopener noreferrer" aria-label="Masy Consulting on Instagram" class="text-ink/60 hover:text-indigo transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-[18px] h-[18px]" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href={siteMeta.facebook} target="_blank" rel="noopener noreferrer" aria-label="Masy Consulting on Facebook" class="text-ink/60 hover:text-indigo transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-[18px] h-[18px]" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.5 9.95v-7.04H7.9V12h2.6V9.8c0-2.56 1.52-3.97 3.85-3.97 1.12 0 2.3.2 2.3.2v2.53h-1.3c-1.28 0-1.68.8-1.68 1.62V12h2.86l-.46 2.91h-2.4v7.04A10 10 0 0 0 22 12Z" />
            </svg>
          </a>
          <a href={siteMeta.tiktok} target="_blank" rel="noopener noreferrer" aria-label="Masy Consulting on TikTok" class="text-ink/60 hover:text-indigo transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-[18px] h-[18px]" aria-hidden="true">
              <path d="M16.5 3c.3 2 1.7 3.6 3.5 4v3c-1.3 0-2.6-.4-3.7-1.1v6.4a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v3.1a2.8 2.8 0 1 0 2 2.7V3h3.2Z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-2.5 text-[12.5px] text-slate-light">
      <span>&copy; {year} Masy Consulting Limited.</span>
      <span>Lagos · London · Toronto · Houston</span>
    </div>
  </div>
</footer>
