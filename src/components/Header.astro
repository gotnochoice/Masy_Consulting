---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navLinks, siteMeta } from '../data/site';

const currentPath = Astro.url.pathname;
---
<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <div class="max-w-content mx-auto px-5 sm:px-8 flex items-center justify-between h-[84px]">
    <Logo size="md" />

    <nav class="hidden lg:flex items-center gap-9" aria-label="Primary">
      {navLinks.map((link) => {
        const active = currentPath === link.href;
        return (
          <a
            href={link.href}
            class:list={[
              'link-underline text-[14px] font-semibold tracking-wide py-1.5 transition-colors duration-200',
              active ? 'text-indigo' : 'text-slate hover:text-indigo',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden lg:flex items-center gap-6">
      <a
        href={siteMeta.clientPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline inline-flex items-center gap-1.5 text-[14px] font-semibold text-slate hover:text-indigo transition-colors duration-200"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        Client Portal
      </a>
      <Button href="/#book" variant="indigo" size="sm" pill={false}>Book a discovery call</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden inline-flex flex-col justify-center items-center gap-[6px] w-11 h-11 -mr-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-transform duration-300"></span>
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-opacity duration-200"></span>
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-transform duration-300"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-0 top-[84px] bottom-0 bg-ink text-paper px-6 pt-8 pb-10 flex-col justify-between hidden"
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="menu-item font-display text-[32px] leading-none py-4 border-b border-white/10 flex items-baseline gap-4"
          style={`--i:${i}`}
        >
          <span class="font-sans font-extrabold text-[12px] tracking-[0.06em] text-orange">0{i + 1}</span>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="pt-8">
      <Button href="/#book" variant="primary" size="lg" pill={false} class="w-full">
        Book a discovery call
      </Button>
      <a
        href={siteMeta.clientPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center justify-center gap-1.5 w-full text-[14px] font-semibold text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        Client Portal
      </a>
    </div>
  </div>
</header>
<!-- Spacer for fixed header -->
<div class="h-[84px]" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  let open = false;
  toggle?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    menu?.classList.toggle('menu-open', open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
  });
</script>

<style>
  #menu-toggle.is-open .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-bar:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.menu-open .menu-item {
    animation: menu-in 0.5s var(--ease-out-quart) both;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
