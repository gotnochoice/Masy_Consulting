---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navLinks, siteMeta } from '../data/site';

const currentPath = Astro.url.pathname;
---
<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <div class="max-w-content mx-auto px-5 sm:px-8 flex items-center justify-between h-[84px]">
    <Logo size="md" />

    <div class="hidden lg:flex items-center gap-8">
      <nav class="flex items-center gap-9" aria-label="Primary">
        {navLinks.map((link) => {
          const active = currentPath === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'nav-quill relative inline-block text-[14px] font-semibold tracking-wide py-1.5 transition-colors duration-200',
                active ? 'text-indigo is-active' : 'text-slate hover:text-indigo',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
              <svg class="nav-quill-underline" viewBox="0 0 140 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2,10 C30,2 90,14 138,4" /></svg>
            </a>
          );
        })}
      </nav>

      <span class="w-px h-5 bg-line" aria-hidden="true"></span>

      <div class="flex items-center gap-6">
        <a
          href="/careers/"
          class="nav-quill relative inline-flex items-center gap-1.5 text-[14px] font-semibold text-slate hover:text-indigo transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/><path d="M2 13h20"/></svg>
          Careers
          <svg class="nav-quill-underline" viewBox="0 0 140 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2,10 C30,2 90,14 138,4" /></svg>
        </a>
        <a
          href={siteMeta.clientPortalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-quill relative inline-flex items-center gap-1.5 text-[14px] font-semibold text-slate hover:text-indigo transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Client Portal
          <svg class="nav-quill-underline" viewBox="0 0 140 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2,10 C30,2 90,14 138,4" /></svg>
        </a>
        <Button href="/#book" variant="indigo" size="sm" pill={false}>Book a discovery call</Button>
      </div>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden inline-flex flex-col justify-center items-center gap-[6px] w-11 h-11 -mr-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-transform duration-300"></span>
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-opacity duration-200"></span>
      <span class="menu-bar block w-[26px] h-[2px] bg-ink transition-transform duration-300"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-0 top-[84px] bottom-0 bg-ink text-paper px-6 pt-8 pb-10 flex-col justify-between hidden"
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="menu-item font-display text-[32px] leading-none py-4 border-b border-white/10 flex items-baseline gap-4"
          style={`--i:${i}`}
        >
          <span class="font-sans font-extrabold text-[12px] tracking-[0.06em] text-orange">0{i + 1}</span>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="pt-8">
      <Button href="/#book" variant="primary" size="lg" pill={false} class="w-full">
        Book a discovery call
      </Button>
      <a
        href="/careers/"
        class="mt-5 inline-flex items-center justify-center gap-1.5 w-full text-[14px] font-semibold text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/><path d="M2 13h20"/></svg>
        Careers
      </a>
      <a
        href={siteMeta.clientPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center justify-center gap-1.5 w-full text-[14px] font-semibold text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        Client Portal
      </a>
    </div>
  </div>
</header>
<!-- Spacer for fixed header -->
<div class="h-[84px]" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  let open = false;

  function setMenu(next: boolean) {
    open = next;
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    menu?.classList.toggle('menu-open', open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => setMenu(!open));

  // Close the menu whenever a link inside it is followed - otherwise
  // the overlay stays open covering the page after an in-page anchor
  // link navigates underneath it, making the tap look like it did
  // nothing.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>

<style>
  #menu-toggle.is-open .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-bar:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.menu-open .menu-item {
    animation: menu-in 0.5s var(--ease-out-quart) both;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Nav links: the site's quill-stroke signature, on hover ---------- */
  .nav-quill-underline {
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 8px;
    overflow: visible;
    pointer-events: none;
  }
  .nav-quill-underline path {
    fill: none;
    stroke: #ff6600;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-quill:hover .nav-quill-underline path,
  .nav-quill:focus-visible .nav-quill-underline path,
  .nav-quill.is-active .nav-quill-underline path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-quill-underline path {
      transition: none;
    }
  }
</style>
