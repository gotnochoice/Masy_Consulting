---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navLinks } from '../data/site';

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-indigo-deep/10">
  <div class="max-w-content mx-auto px-5 sm:px-8 flex items-center justify-between h-[76px]">
    <Logo size="md" />

    <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
      {navLinks.map((link) => {
        const active = currentPath === link.href;
        return (
          <a
            href={link.href}
            class:list={[
              'text-[14.5px] font-medium tracking-wide transition-colors duration-200 py-2',
              active ? 'text-indigo-deep' : 'text-slate hover:text-indigo-deep',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden lg:block">
      <Button href="/contact/" variant="primary" size="sm">Book a consultation</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden inline-flex flex-col justify-center items-center gap-[5px] w-10 h-10 -mr-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span class="menu-bar block w-6 h-[2px] bg-indigo-deep transition-transform duration-300"></span>
      <span class="menu-bar block w-6 h-[2px] bg-indigo-deep transition-opacity duration-200"></span>
      <span class="menu-bar block w-6 h-[2px] bg-indigo-deep transition-transform duration-300"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-indigo-deep/10 bg-white">
    <nav class="flex flex-col px-5 py-4 gap-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[15px] font-medium text-indigo-deep py-3 border-b border-indigo-deep/5 last:border-none"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4">
        <Button href="/contact/" variant="primary" size="sm" class="w-full justify-center">
          Book a consultation
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  let open = false;
  toggle?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
  });
</script>

<style>
  #menu-toggle.is-open .menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-bar:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
