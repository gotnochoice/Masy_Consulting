---
interface Props {
  class?: string;
  color?: string;
}
const { class: className = '', color = '#FB961F' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Masy Consulting mark"
>
  <mask id="masy-crescent">
    <rect width="100" height="100" fill="white" />
    <circle cx="60" cy="46" r="29" fill="black" />
  </mask>
  <circle cx="44" cy="52" r="34" fill={color} mask="url(#masy-crescent)" />
  <path
    d="M0,0 L-3,-6 L-9,-10 L-6,-14 L-13,-19 L-9,-23 L-15,-28 L-10,-32 L-16,-37 L-11,-41 L-15,-46 L-9,-49 L-11,-53 L-4,-55 L0,-58 L3,-56 L6,-50 L5,-42 L7,-34 L4,-26 L5,-18 L2,-9 Z"
    fill={color}
    transform="translate(52,64) rotate(39) scale(0.93)"
  />
</svg>
