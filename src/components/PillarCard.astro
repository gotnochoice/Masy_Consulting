---
interface Props {
  number: string;
  name: string;
  short: string;
  href: string;
  anchor?: boolean;
  points: string[];
}
const { number, name, short, href, anchor = false, points } = Astro.props;
---
<a
  href={href}
  class:list={[
    'group relative flex flex-col justify-between p-7 sm:p-8 min-h-[340px] rounded-2xl border transition-all duration-300',
    anchor
      ? 'bg-indigo-deep text-white border-indigo-deep hover:bg-indigo-light'
      : 'bg-sand text-indigo-deep border-transparent hover:border-indigo-deep/15 hover:bg-white hover:shadow-[0_20px_50px_-25px_rgba(28,14,107,0.35)]',
  ]}
>
  {anchor && (
    <span class="absolute top-6 right-7 font-mono text-[10px] uppercase tracking-[0.14em] text-orange border border-orange/40 rounded-full px-2.5 py-1">
      Anchor service
    </span>
  )}
  <div>
    <span class:list={['font-mono text-[13px]', anchor ? 'text-white/40' : 'text-indigo-deep/35']}>{number}</span>
    <h3 class="mt-4 font-display text-[26px] sm:text-[28px] leading-[1.15] tracking-tight text-balance">
      {name}
    </h3>
    <p class:list={['mt-3 text-[15px] leading-relaxed', anchor ? 'text-white/70' : 'text-slate']}>{short}</p>
    <ul class="mt-5 space-y-2">
      {points.map((p) => (
        <li class:list={['flex items-start gap-2 text-[13.5px]', anchor ? 'text-white/60' : 'text-slate']}>
          <span class="mt-[7px] w-1 h-1 rounded-full bg-orange shrink-0"></span>
          {p}
        </li>
      ))}
    </ul>
  </div>
  <div class:list={['mt-8 inline-flex items-center gap-2 text-[14px] font-medium', anchor ? 'text-orange' : 'text-indigo-deep']}>
    Explore the pillar
    <svg
      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
      viewBox="0 0 16 16"
      fill="none"
    >
      <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</a>
