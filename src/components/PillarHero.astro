---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

interface Props {
  number: string;
  label: string;
  title: string;
  titleAccent?: string;
  lead: string;
  facts?: [string, string][];
  primaryHref?: string;
  primaryLabel?: string;
}
const {
  number,
  label,
  title,
  titleAccent,
  lead,
  facts = [],
  primaryHref = '/contact/',
  primaryLabel = 'Book a consultation',
} = Astro.props;
---
<section class="relative overflow-hidden border-b border-ink/10">
  <div
    class="absolute -right-40 -top-32 w-[560px] h-[560px] rounded-full opacity-[0.08] pointer-events-none"
    style="background: radial-gradient(circle, #FB961F 0%, transparent 66%)"
  ></div>

  <div class="max-w-content mx-auto px-5 sm:px-8 pt-8 sm:pt-12 pb-16 sm:pb-24 relative">
    <a href="/#pillars" class="inline-flex items-center gap-2 text-[13.5px] font-medium text-slate hover:text-ink transition-colors">
      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13 8H3M3 8L7.2 3.8M3 8L7.2 12.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      All services
    </a>

    <div class="mt-10 grid lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      <div class="lg:col-span-7">
        <Eyebrow num={number}>{label}</Eyebrow>
        <h1 class="mt-7 font-display font-medium text-[clamp(2.4rem,5.6vw,4.25rem)] leading-[1.02] tracking-[-0.02em] text-ink text-balance">
          {title}
          {titleAccent && (
            <span class="italic font-display-soft text-indigo"> {titleAccent}</span>
          )}
        </h1>
        <p class="mt-7 text-[16.5px] sm:text-[18px] text-slate leading-relaxed max-w-2xl text-pretty">
          {lead}
        </p>
        <div class="mt-9">
          <Button href={primaryHref} variant="primary" size="lg" magnetic>{primaryLabel}</Button>
        </div>
      </div>

      {facts.length > 0 && (
        <div class="lg:col-span-4 lg:col-start-9" data-reveal="right">
          <div class="relative overflow-hidden rounded-[1.5rem] bg-ink text-white p-7 sm:p-8 dark-section shadow-[0_40px_80px_-40px_rgba(20,10,69,0.55)]">
            <div class="absolute inset-0 grain-overlay"></div>
            <p class="relative font-mono text-[11px] uppercase tracking-[0.2em] text-orange mb-5">At a glance</p>
            <dl class="relative divide-y divide-white/[0.08]">
              {facts.map(([k, v]) => (
                <div class="py-3.5 first:pt-0 last:pb-0 flex items-baseline justify-between gap-6">
                  <dt class="text-[13px] text-white/50 shrink-0">{k}</dt>
                  <dd class="text-[14px] font-medium text-right">{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
