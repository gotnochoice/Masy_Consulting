---
const rows = [
  {
    number: '01',
    name: 'Fractional HR & People Management',
    dek: 'You run the business from the UK or US. We manage your African team so you don’t have to.',
    tags: ['Monthly retainer', 'Anchor service'],
    href: '/fractional-hr/',
  },
  {
    number: '02',
    name: 'Business Writing',
    dek: 'Proposals, pitch decks, and reports that carry the same quality as the business behind them.',
    tags: ['Per document'],
    href: '/business-writing/',
  },
  {
    number: '03',
    name: 'Industry Analysis & Market Surveys',
    dek: 'Grounded research for the market you’re about to enter and the decision riding on it.',
    tags: ['Per project'],
    href: '/industry-analysis/',
  },
];
---
<div class="border-t border-ink/15" data-reveal-stagger>
  {rows.map((row) => (
    <a
      href={row.href}
      class="pillar-row group grid grid-cols-[auto_1fr] lg:grid-cols-[80px_1fr_minmax(0,340px)_60px] items-baseline lg:items-center gap-x-5 gap-y-2 border-b border-ink/15 py-8 sm:py-10 px-2 sm:px-4 text-ink hover:text-paper focus-visible:text-paper outline-none"
    >
      <span class="font-mono text-[13px] text-orange-deep group-hover:text-orange row-num">{row.number}</span>
      <div class="min-w-0">
        <h3 class="font-display font-bold text-[clamp(1.5rem,3.4vw,2.6rem)] leading-[1.05] tracking-[-0.01em] text-balance">
          {row.name}
        </h3>
        <p class="lg:hidden mt-2.5 text-[14.5px] leading-relaxed text-slate group-hover:text-paper/70 max-w-xl">
          {row.dek}
        </p>
        <div class="lg:hidden mt-3 flex flex-wrap gap-2">
          {row.tags.map((t) => (
            <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] border border-current/25 rounded-full px-3 py-1 opacity-70">
              {t}
            </span>
          ))}
        </div>
      </div>
      <div class="hidden lg:block">
        <p class="text-[14.5px] leading-relaxed text-slate group-hover:text-paper/70">{row.dek}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {row.tags.map((t) => (
            <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] border border-ink/20 group-hover:border-paper/30 rounded-full px-3 py-1 opacity-80">
              {t}
            </span>
          ))}
        </div>
      </div>
      <span class="hidden lg:flex justify-end">
        <svg
          class="w-7 h-7 -rotate-45 group-hover:rotate-0 transition-transform duration-500 ease-out-quart"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 12H20M20 12L13.5 5.5M20 12L13.5 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  ))}
</div>
