---
interface Props {
  model: string;
  points: string[];
}
const { model, points } = Astro.props;
---
<div class="rounded-2xl border border-orange/30 bg-orange/5 p-7 sm:p-9">
  <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-orange-deep mb-4">How pricing works</p>
  <p class="font-display text-[21px] sm:text-[23px] text-indigo-deep leading-snug max-w-xl text-pretty">{model}</p>
  <ul class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-2.5">
    {points.map((p) => (
      <li class="flex items-start gap-2.5 text-[14px] text-slate leading-relaxed">
        <span class="mt-[7px] w-1 h-1 rounded-full bg-orange-deep shrink-0"></span>
        {p}
      </li>
    ))}
  </ul>
</div>
