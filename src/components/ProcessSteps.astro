---
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
  dark?: boolean;
}
const { steps, dark = false } = Astro.props;
---
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 lg:gap-y-0" data-reveal-stagger>
  {steps.map((step, i) => (
    <div class:list={['relative pt-8 border-t-2', dark ? 'border-white/15' : 'border-ink/12']}>
      <span class="absolute -top-[7px] left-0 w-3 h-3 rounded-full bg-orange"></span>
      <span class:list={['font-mono text-[12px]', dark ? 'text-orange' : 'text-orange-deep']}>
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class:list={['mt-3 font-display font-bold text-[20px] leading-snug', dark ? 'text-white' : 'text-ink']}>
        {step.title}
      </h3>
      <p class:list={['mt-2.5 text-[14px] leading-relaxed text-pretty', dark ? 'text-white/60' : 'text-slate']}>
        {step.body}
      </p>
    </div>
  ))}
</div>
