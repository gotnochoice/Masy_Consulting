---
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---
<ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-indigo-deep/10 rounded-2xl overflow-hidden">
  {steps.map((step, i) => (
    <li class="bg-white p-7 sm:p-8 flex flex-col">
      <span class="font-mono text-orange-deep text-sm">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="mt-4 font-display text-[19px] leading-snug text-indigo-deep">{step.title}</h3>
      <p class="mt-2.5 text-[14px] text-slate leading-relaxed text-pretty">{step.body}</p>
    </li>
  ))}
</ol>
