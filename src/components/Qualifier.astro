---
interface Props {
  fitTitle?: string;
  fit: string[];
  notFitTitle?: string;
  notFit: string[];
}
const {
  fitTitle = 'This is built for you if',
  fit,
  notFitTitle = 'It probably isn’t, if',
  notFit,
} = Astro.props;
---
<div class="grid md:grid-cols-2 border border-ink/12 rounded-[1.5rem] overflow-hidden" data-reveal>
  <div class="bg-white p-8 sm:p-10 md:border-r border-ink/12">
    <h3 class="font-display font-medium text-[22px] text-ink flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-orange"></span>
      {fitTitle}
    </h3>
    <ul class="mt-6 space-y-4">
      {fit.map((item) => (
        <li class="flex items-start gap-3.5 text-[15px] text-slate leading-relaxed">
          <svg class="w-[18px] h-[18px] mt-0.5 shrink-0 text-orange-deep" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10.5L8 14.5L16 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
  <div class="bg-paper p-8 sm:p-10 border-t md:border-t-0 border-ink/12">
    <h3 class="font-display font-medium text-[22px] text-ink flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-ink/25"></span>
      {notFitTitle}
    </h3>
    <ul class="mt-6 space-y-4">
      {notFit.map((item) => (
        <li class="flex items-start gap-3.5 text-[15px] text-slate leading-relaxed">
          <svg class="w-[18px] h-[18px] mt-0.5 shrink-0 text-ink/35" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>
