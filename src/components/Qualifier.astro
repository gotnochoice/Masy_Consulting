---
interface Props {
  fitTitle?: string;
  fit: string[];
  notFitTitle?: string;
  notFit: string[];
}
const { fitTitle = 'This is built for you if', fit, notFitTitle = 'It probably isn’t, if', notFit } = Astro.props;
---
<div class="grid md:grid-cols-2 gap-px bg-indigo-deep/10 rounded-2xl overflow-hidden">
  <div class="bg-white p-7 sm:p-9">
    <h3 class="font-display text-[20px] text-indigo-deep flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-orange"></span>
      {fitTitle}
    </h3>
    <ul class="mt-5 space-y-3.5">
      {fit.map((item) => (
        <li class="flex items-start gap-3 text-[14.5px] text-slate leading-relaxed">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-orange-deep" viewBox="0 0 20 20" fill="none">
            <path d="M4 10.5L8 14.5L16 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
  <div class="bg-sand p-7 sm:p-9">
    <h3 class="font-display text-[20px] text-indigo-deep flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-indigo-deep/30"></span>
      {notFitTitle}
    </h3>
    <ul class="mt-5 space-y-3.5">
      {notFit.map((item) => (
        <li class="flex items-start gap-3 text-[14.5px] text-slate leading-relaxed">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-indigo-deep/35" viewBox="0 0 20 20" fill="none">
            <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>
