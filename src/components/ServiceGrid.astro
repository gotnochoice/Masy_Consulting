---
interface Item {
  title: string;
  body: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="grid sm:grid-cols-2 gap-5">
  {items.map((item) => (
    <div class="p-6 sm:p-7 rounded-xl bg-sand">
      <div class="flex items-start gap-3.5">
        <svg class="w-5 h-5 mt-0.5 shrink-0 text-orange-deep" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4" />
          <path d="M6.5 10.2L8.8 12.5L13.5 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div>
          <h3 class="font-display text-[17.5px] text-indigo-deep leading-snug">{item.title}</h3>
          <p class="mt-1.5 text-[14px] text-slate leading-relaxed text-pretty">{item.body}</p>
        </div>
      </div>
    </div>
  ))}
</div>
