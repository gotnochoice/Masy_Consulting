---
interface Item {
  title: string;
  body: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="grid sm:grid-cols-2 gap-x-12 gap-y-0 sm:gap-y-2" data-reveal-stagger>
  {items.map((item, i) => (
    <div class="py-7 border-t border-ink/12 grid grid-cols-[auto_1fr] gap-x-5">
      <span class="font-mono text-[12px] text-orange-deep pt-1.5">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <h3 class="font-display font-medium text-[20px] sm:text-[22px] text-ink leading-snug">{item.title}</h3>
        <p class="mt-2.5 text-[14.5px] text-slate leading-relaxed text-pretty">{item.body}</p>
      </div>
    </div>
  ))}
</div>
