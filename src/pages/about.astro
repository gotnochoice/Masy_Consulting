---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Marker from '../components/Marker.astro';
import Marquee from '../components/Marquee.astro';
import CTASection from '../components/CTASection.astro';

const principles = [
  {
    num: '01',
    title: 'Lead with your problem, not our pitch',
    body: 'Every conversation starts with what’s actually slowing your business down, not a list of things we’d like to sell you.',
  },
  {
    num: '02',
    title: 'Teach something real, every time',
    body: 'If a piece of writing or a call wouldn’t teach you something true, even if you never hire us, we don’t publish it.',
  },
  {
    num: '03',
    title: 'Confident, never arrogant',
    body: 'We’ll tell you plainly when something won’t work. We won’t dress up uncertainty as expertise.',
  },
  {
    num: '04',
    title: 'Specific, never generic',
    body: 'No borrowed frameworks, no "synergy," no consulting clichés. If a claim can’t be backed by real capability, we don’t make it.',
  },
];
---
<BaseLayout
  title="About Masy Consulting"
  description="Masy Consulting exists to give African-founded and diaspora-owned businesses the writing, people operations, and market intelligence of a world-class consultancy, grounded in real operational understanding."
>
  <section class="relative overflow-hidden border-b border-ink/10">
    <div
      class="absolute -left-32 -top-32 w-[520px] h-[520px] rounded-full opacity-[0.08] pointer-events-none"
      style="background: radial-gradient(circle, #FF6600 0%, transparent 66%)"
    ></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 pt-12 sm:pt-20 pb-16 sm:pb-24 relative">
      <Eyebrow>About Masy</Eyebrow>
      <h1 class="mt-7 font-display font-bold text-[clamp(2.4rem,5.8vw,4.5rem)] leading-[1.02] tracking-[-0.02em] text-ink max-w-4xl text-balance">
        Built on operational understanding,
        <span class="text-indigo">not borrowed theory.</span>
      </h1>
      <p class="mt-8 text-[17px] sm:text-[18.5px] text-slate leading-relaxed max-w-2xl text-pretty" data-reveal>
        Masy Consulting exists to give African-founded and diaspora-owned
        businesses the writing, the people operations, and the market
        intelligence of a world-class consultancy, grounded in real
        understanding of how African businesses actually operate.
      </p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5" data-reveal>
        <Marker idx="01" label="Why we exist" count="01 / 05" />
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink text-balance">
          Three problems that usually get handled by three different people, badly.
        </h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 space-y-6 text-[16px] text-slate leading-relaxed text-pretty" data-reveal-stagger>
        <p>
          Most businesses we talk to are already solving these problems, just
          inefficiently. A cousin drafts the proposal. A friend "handles HR"
          between their own job and yours. Market research means a few hours on
          Google before a decision that deserves more.
        </p>
        <p>
          None of that is a criticism. It's what happens when a business grows
          faster than its support structure, and when the professional services
          built for it were designed for a different market entirely: expensive
          institutional consultancies on one end, transactional freelancers on
          the other.
        </p>
        <p>
          Masy exists in the space between. Three connected capabilities,
          handled by one partner who understands your operating context because
          our practice was built specifically around it, not adapted from
          someone else's.
        </p>
      </div>
    </div>
  </section>

  <section class="relative bg-ink text-white overflow-hidden dark-section">
    <div class="absolute inset-0 grain-overlay"></div>
    <img
      src="/logo-mark.png"
      alt=""
      class="absolute -right-20 -top-24 w-[380px] opacity-[0.05] pointer-events-none select-none"
      aria-hidden="true"
    />
    <div class="max-w-content mx-auto px-5 sm:px-8 py-24 sm:py-32 relative">
      <div class="max-w-4xl" data-reveal>
        <Marker idx="02" label="Our positioning" count="02 / 05" tone="dark" />
        <p class="mt-8 font-display text-[clamp(1.8rem,4.2vw,3.2rem)] leading-[1.14] tracking-[-0.015em] text-balance">
          For the business owner who needs their documents, their people, and
          their market intelligence handled with the same rigor as their
          business idea.
        </p>
        <p class="mt-9 font-display text-[clamp(1.4rem,2.8vw,2rem)] text-orange">
          Most consultants theorise. Masy delivers.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div data-reveal>
      <Marker idx="03" label="How we work" count="03 / 05" />
      <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
        A handful of rules we don't break, even when it would be easier to.
      </h2>
    </div>
    <div class="mt-12 grid sm:grid-cols-2 gap-x-12" data-reveal-stagger>
      {principles.map((p) => (
        <div class="py-8 border-t border-ink/12 grid grid-cols-[auto_1fr] gap-x-6">
          <span class="ghost-num font-display text-[clamp(2.2rem,4vw,3.2rem)] select-none" aria-hidden="true">{p.num}</span>
          <div>
            <h3 class="font-display font-bold text-[21px] text-ink leading-snug">{p.title}</h3>
            <p class="mt-2.5 text-[14.5px] text-slate leading-relaxed text-pretty">{p.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Marquee items={['Insight first', 'Evidence over confidence', 'One partner, three pillars', 'UK · US · Canada · Nigeria']} />

  <section class="bg-white">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
      <div class="grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5" data-reveal>
          <Marker idx="04" label="The team" count="04 / 05" />
          <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink text-balance">
            A small, senior team. Not a rotating bench of juniors.
          </h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7" data-reveal>
          <p class="text-[16px] text-slate leading-relaxed text-pretty">
            Masy is run by people who have sat inside African businesses and
            diaspora-owned companies, not just consulted for them from a
            distance. Every engagement, from a single proposal to an ongoing HR
            retainer, is handled by someone senior enough to make a call
            without escalating it three times first.
          </p>
          <p class="mt-6 text-[15px] text-slate/80 leading-relaxed">
            Want to know exactly who you'd be working with before you commit?
            Ask on your consultation call. We'll tell you plainly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    marker={{ idx: '05', label: 'Get started', count: '05 / 05' }}
    heading="If this sounds like how you'd want a firm to operate, let's talk."
    body="Thirty minutes. No obligation. We'll tell you honestly whether Masy is the right fit for what you need."
    secondaryLabel="Read our insights"
    secondaryHref="/insights/"
  />
</BaseLayout>
