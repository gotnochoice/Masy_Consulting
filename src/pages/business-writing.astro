---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const startupItems = [
  { label: 'Pitch decks' },
  { label: 'Business proposals' },
  { label: 'Financial model projects', note: 'Built with FounderDeck, Masy’s own modelling tool' },
];

const smeItems = [
  { label: 'Business proposals' },
  { label: 'Ghostwriting, articles and blogs' },
  { label: 'Market research write-ups' },
  { label: 'Grant and proposal review' },
];

const steps = [
  { title: 'Book a discovery call', body: 'Tell us what you need, a pitch deck, a proposal, or ongoing writing support.' },
  { title: 'We scope it', body: 'Startup or SME track, a clear deliverable list, and what it costs, no long contracts.' },
  { title: 'We write it', body: 'Drafted, reviewed, and refined until it’s ready to send.' },
  { title: 'You send it', body: 'Confident it holds up wherever it lands.' },
];

const faqs = [
  {
    q: 'Do you only write for fundraising?',
    a: 'No. The Startup track is built for founders raising capital, but the SME track covers ongoing written work for businesses that aren’t currently fundraising.',
  },
  {
    q: 'How fast can you turn around a document?',
    a: 'Depends on the deliverable. We’ll give you a real timeline on the discovery call once we know what you need, not a generic estimate upfront.',
  },
  {
    q: 'What’s a financial model project?',
    a: 'A financial model built using FounderDeck, Masy’s own modelling tool, so the numbers behind your pitch deck hold up to real scrutiny.',
  },
];
---
<BaseLayout
  title="Business Writing — Proposals, Pitch Decks & Corporate Reports"
  description="Masy Consulting writes the business proposals, pitch decks, and financial models that carry the same quality as the business behind them. For founders raising capital and SMEs alike."
>
  <section class="pt-16 sm:pt-20 pb-16 sm:pb-[70px]">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <p class="font-mono text-[13px] font-bold uppercase tracking-[0.08em] text-orange mb-5">Business Writing</p>
      <h1 class="font-display font-extrabold text-[clamp(2.6rem,6vw,4.8rem)] leading-[0.98] tracking-[-0.03em] text-ink max-w-[900px] mb-7">
        Your paperwork should read as sharp as your <span class="sig">business<svg viewBox="0 0 260 18" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9c45-8 190-8 256 5"/></svg></span>.
      </h1>
      <p class="text-[19px] max-w-[520px] mb-9 text-slate">
        Whether you're raising a round or running an SME, we write it, model it, and make sure it's ready before it needs to be.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/contact/" variant="primary" size="lg">Book a discovery call</Button>
        <Button href="/contact/" variant="outline" size="lg">WhatsApp us</Button>
      </div>
    </div>
  </section>

  <div class="relative h-[240px] sm:h-[360px]">
    <img
      src="/four.jpg"
      alt="A consultant writing in a notebook beside her laptop and financial charts"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <section class="grid md:grid-cols-2" data-reveal-stagger>
    <div class="bg-indigo text-white py-14 sm:py-[72px] px-6 sm:px-14">
      <span class="block font-mono text-[12.5px] font-bold uppercase tracking-[0.06em] opacity-70 mb-[18px]">For founders raising capital</span>
      <h2 class="font-display font-bold text-[clamp(1.9rem,3vw,2.6rem)] text-white mb-4">Startup</h2>
      <p class="text-[16px] max-w-[380px] mb-7 text-[#D9D3F2]">Documents that need to survive a pitch meeting, not just look good in a folder.</p>
      <ul class="flex flex-col gap-4">
        {startupItems.map((item, i) => (
          <li class:list={['text-[1.15rem] font-bold tracking-[-0.01em] pb-4', i < startupItems.length - 1 && 'border-b-[1.5px] border-white/20']}>
            {item.label}
            {item.note && <span class="block text-[13px] font-normal mt-1 text-[#B9AEE0]">{item.note}</span>}
          </li>
        ))}
      </ul>
    </div>
    <div class="bg-orange text-ink py-14 sm:py-[72px] px-6 sm:px-14">
      <span class="block font-mono text-[12.5px] font-bold uppercase tracking-[0.06em] opacity-70 mb-[18px]">For businesses that need it ongoing</span>
      <h2 class="font-display font-bold text-[clamp(1.9rem,3vw,2.6rem)] text-ink mb-4">SME</h2>
      <p class="text-[16px] max-w-[380px] mb-7 text-ink/80">Recurring written work for a business that doesn't stop needing it after the first proposal.</p>
      <ul class="flex flex-col gap-4">
        {smeItems.map((item, i) => (
          <li class:list={['text-[1.15rem] font-bold tracking-[-0.01em] pb-4', i < smeItems.length - 1 && 'border-b-[1.5px] border-ink/20']}>
            {item.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <p class="max-w-content mx-auto px-5 sm:px-8 mt-10 text-[14px] text-slate/80 max-w-xl leading-relaxed" data-reveal>
    Masy Consulting does not offer academic writing, essays, or tutoring of
    any kind. That work belongs entirely to
    <a href="https://masyacademy.com" target="_blank" rel="noopener noreferrer" class="link-underline text-ink font-medium">Masy Academy</a>,
    a separate company.
  </p>

  <section class="py-24">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <h2 class="font-display font-bold text-[clamp(1.9rem,3.4vw,2.7rem)] max-w-[640px] mb-14 text-ink" data-reveal>
        Four steps, start to finish.
      </h2>
      <div data-reveal>
        {steps.map((step, i) => (
          <div class:list={['grid grid-cols-[60px_1fr] sm:grid-cols-[100px_1fr] gap-8 items-start py-[30px] border-t border-ink/10', i === steps.length - 1 && 'border-b']}>
            <span class="font-mono text-[22px] font-bold text-orange">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display font-bold text-[1.3rem] text-ink mb-1.5">{step.title}</h3>
              <p class="text-[15px] text-slate max-w-[480px]">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="max-w-[720px] border-t border-ink/10" data-reveal>
        {faqs.map((f) => (
          <details class="plain-faq border-b border-ink/10">
            <summary class="list-none cursor-pointer flex justify-between gap-5 py-[26px] px-1 font-display font-bold text-ink text-[18px]">
              {f.q}
              <span class="faq-plus shrink-0"></span>
            </summary>
            <p class="px-1 pb-[26px] text-[15px] max-w-[600px] text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-ink py-16 sm:py-[88px] text-center">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <h2 class="font-display font-bold text-[clamp(2rem,4vw,3rem)] text-white mb-[18px]">Let's take this off your plate.</h2>
      <p class="text-[#B9B4C9] text-[16px] mb-8">Book a discovery call, or message us on WhatsApp, whichever's easier.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contact/" variant="primary" size="lg">Book a discovery call</Button>
        <Button href="/contact/" variant="outlineDark" size="lg">WhatsApp us</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sig {
    position: relative;
    display: inline-block;
    color: var(--indigo, #281398);
  }
  .sig svg {
    position: absolute;
    left: -2%;
    bottom: -8px;
    width: 104%;
    height: 18px;
    overflow: visible;
  }
  .sig path {
    stroke: #fb961f;
    stroke-width: 4;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    animation: draw 1s var(--ease-out-expo) 0.3s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .plain-faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-plus {
    width: 22px;
    height: 22px;
    position: relative;
  }
  .faq-plus::before,
  .faq-plus::after {
    content: '';
    position: absolute;
    background: theme('colors.ink');
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }
  .faq-plus::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-plus::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .plain-faq[open] .faq-plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .sig path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
