---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marker from '../components/Marker.astro';
import ProcessLine from '../components/ProcessLine.astro';
import FaqCards from '../components/FaqCards.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';

const facts = [
  { label: 'Two tracks', body: 'Startup, for fundraising documents, and SME, for ongoing written work. Scoped on the discovery call.' },
  { label: 'One team', body: 'The same people who write your proposal can write your next one. No re-briefing a new freelancer each time.' },
  { label: 'Every timezone', body: 'UK, US, Canada, and Nigeria. Wherever you’re based, the process doesn’t change.' },
  { label: 'Pricing', body: 'Fixed and agreed upfront once we’ve seen your brief, with one revision round included.' },
];

const startupItems = [
  'Pitch decks',
  'Business proposals',
  'Financial model projects, built with our own financial modelling tool',
];

const smeItems = [
  'Business proposals',
  'Ghostwriting of articles and blogs',
  'Market research write-ups',
  'Grant and proposal review',
];

const steps = [
  { title: 'Book a discovery call', body: 'Tell us what you need, a pitch deck, a proposal, or ongoing writing support.' },
  { title: 'We scope it', body: 'Startup or SME track, a clear deliverable list, and what it costs, no long contracts.' },
  { title: 'We write it', body: 'Drafted, reviewed, and refined until it’s ready to send.' },
  { title: 'You send it', body: 'Confident it holds up wherever it lands.' },
];

const faqs = [
  {
    q: 'Do you only write for fundraising?',
    a: 'No. The Startup track is built for founders raising capital, but the SME track covers ongoing written work for businesses that aren’t currently fundraising.',
  },
  {
    q: 'How fast can you turn around a document?',
    a: 'Depends on the deliverable. We’ll give you a real timeline on the discovery call once we know what you need, not a generic estimate upfront.',
  },
  {
    q: 'What’s a financial model project?',
    a: 'A financial model built using our own modelling tool, so the numbers behind your pitch deck hold up to real scrutiny.',
  },
];
---
<BaseLayout
  title="Business Writing | Proposals, Pitch Decks & Financial Models"
  description="Masy Consulting writes the business proposals, pitch decks, and financial models that carry the same quality as the business behind them. For founders raising capital and SMEs alike."
>
  <section class="pt-14 sm:pt-16">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center pb-14 sm:pb-16">
        <div>
          <p class="font-mono text-[12.5px] font-semibold uppercase tracking-[0.06em] text-orange mb-4">Business Writing</p>
          <h1 class="font-display font-extrabold text-[clamp(2.3rem,4.6vw,3.5rem)] leading-[1.06] tracking-[-0.03em] text-ink mb-5">
            Documents built to hold up in front of <span class="sig">investors, partners<svg viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c55-7 250-7 316 4"/></svg></span>, or clients.
          </h1>
          <p class="text-[17px] max-w-[460px] mb-[30px] text-slate">
            Whether you're raising a round or running an SME, your paperwork should read as sharp as the business behind it. We write it, model it, and make sure it's ready before it needs to be.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="/contact/" variant="primary">Book a discovery call</Button>
            <Button href="/contact/" variant="outline">WhatsApp us</Button>
          </div>
        </div>
        <div class="hero-photo relative rounded-[12px] overflow-hidden aspect-[4/5] shadow-[0_40px_70px_-36px_rgba(26,19,48,0.4)]">
          <img
            src="/four.jpg"
            alt="A consultant writing in a notebook beside her laptop and financial charts"
            class="ph-layer absolute inset-[-6%] w-[112%] h-[112%] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0" style="background: linear-gradient(200deg, rgba(26,19,48,0.04) 0%, rgba(26,19,48,0.3) 100%);"></div>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 py-[26px] border-t border-b border-ink/10">
        {facts.map((fact) => (
          <div>
            <h4 class="text-[12px] font-bold uppercase tracking-[0.05em] text-indigo mb-1.5">{fact.label}</h4>
            <p class="text-[14px] text-slate leading-relaxed">{fact.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="01" label="What's included" count="01 / 03" />
      <div class="mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.1] tracking-[-0.03em] text-ink mb-3.5">
          Two tracks, one standard.
        </h2>
        <p class="text-[15.5px] text-slate max-w-xl leading-relaxed">
          What you need depends on where your business is right now. Tell us on the discovery call, and we'll scope the right one, or a mix of both.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6" data-reveal-stagger>
        <div class="relative overflow-hidden rounded-[12px] bg-ink text-white p-8 sm:p-9 flex flex-col gap-4 dark-section shadow-[0_18px_40px_-26px_rgba(26,19,48,0.5)] transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:shadow-[0_30px_56px_-26px_rgba(26,19,48,0.55)]">
          <div class="absolute inset-0 grain-overlay"></div>
          <div class="relative flex flex-col gap-4 flex-1">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-orange-light">For founders raising capital</p>
            <h3 class="font-display font-bold text-[1.5rem] text-white -mt-1">Startup</h3>
            <p class="text-[14.5px] text-[#C6BEEF] leading-relaxed">Documents that need to survive a pitch meeting, not just look good in a folder.</p>
            <ul class="mt-1 space-y-2.5">
              {startupItems.map((item) => (
                <li class="flex items-start gap-2.5 text-[14.5px] text-[#E4E1F0] leading-relaxed">
                  <span class="mt-[9px] w-1.5 h-1.5 rounded-full bg-orange shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-auto pt-4 border-t border-white/15 text-[12.5px] text-[#9B92C9]">Best for a founder scoping a raise in the next few months.</p>
          </div>
        </div>
        <div class="rounded-[12px] bg-white border border-ink/12 p-8 sm:p-9 flex flex-col gap-4 shadow-[0_14px_30px_-26px_rgba(26,19,48,0.18)] transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:shadow-[0_28px_50px_-28px_rgba(26,19,48,0.24)] hover:border-indigo-light">
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-orange">For businesses that need it ongoing</p>
          <h3 class="font-display font-bold text-[1.5rem] text-ink -mt-1">SME</h3>
          <p class="text-[14.5px] text-slate leading-relaxed">Recurring written work for a business that doesn't stop needing it after the first proposal.</p>
          <ul class="mt-1 space-y-2.5">
            {smeItems.map((item) => (
              <li class="flex items-start gap-2.5 text-[14.5px] text-slate leading-relaxed">
                <span class="mt-[9px] w-1.5 h-1.5 rounded-full bg-orange shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-auto pt-4 border-t border-ink/10 text-[12.5px] text-slate/50">Best for a business that needs a steady stream of sharp written material.</p>
        </div>
      </div>
      <p class="mt-10 pl-4 border-l-2 border-orange/40 text-[14px] text-slate/80 max-w-xl leading-relaxed" data-reveal>
        Masy Consulting does not offer academic writing, essays, or tutoring of
        any kind. That work belongs entirely to
        <a href="https://masyacademy.com" target="_blank" rel="noopener noreferrer" class="link-underline text-ink font-medium">Masy Academy</a>,
        a separate company.
      </p>
    </div>
  </section>

  <section class="bg-paper-2 py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="02" label="How it works" count="02 / 03" />
      <div class="mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.1] tracking-[-0.03em] text-ink">
          Four steps, start to finish.
        </h2>
      </div>
      <ProcessLine steps={steps} />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="03" label="FAQ" count="03 / 03" />
      <div class="text-center max-w-[640px] mx-auto mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.7rem,3vw,2.3rem)] text-ink">
          Questions people ask before booking a call.
        </h2>
      </div>
      <FaqCards items={faqs} />
    </div>
  </section>

  <CTASection
    heading="Let's take this off your plate."
    body="Book a discovery call, or message us on WhatsApp, whichever's easier."
    primaryLabel="Book a discovery call"
    secondaryLabel="WhatsApp us"
    secondaryHref="/contact/"
  />
</BaseLayout>

<style>
  .bg-paper-2 {
    background: #f7f5f0;
  }
  .hero-photo .ph-layer {
    animation: kenburns 22s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from {
      transform: scale(1) translate(0, 0);
    }
    to {
      transform: scale(1.07) translate(-1%, 1%);
    }
  }
  .sig {
    position: relative;
    display: inline-block;
    color: var(--indigo, #4D148C);
  }
  .sig svg {
    position: absolute;
    left: -2%;
    bottom: -6px;
    width: 104%;
    height: 16px;
    overflow: visible;
  }
  .sig path {
    stroke: #ff6600;
    stroke-width: 3.5;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    animation: draw 1s var(--ease-out-expo) 0.3s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sig path {
      stroke-dashoffset: 0;
      animation: none;
    }
    .hero-photo .ph-layer {
      animation: none;
    }
  }
</style>
