---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { siteMeta } from '../data/site';

const services = ['Fractional HR & People Management', 'Business Writing', 'Industry Analysis & Market Surveys', 'Not sure yet'];
---
<BaseLayout
  title="Book a Consultation"
  description="Book a free consultation with Masy Consulting. Tell us about your business and we'll tell you plainly how we'd help, or if we're not the right fit."
>
  <section class="max-w-content mx-auto px-5 sm:px-8 pt-14 sm:pt-20 pb-20 sm:pb-28">
    <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-14">
      <div>
        <Eyebrow>Start a conversation</Eyebrow>
        <h1 class="mt-6 font-display font-medium text-[clamp(2.1rem,5vw,3.25rem)] leading-[1.08] tracking-tight text-indigo-deep text-balance">
          Book a free consultation.
        </h1>
        <p class="mt-6 text-[16.5px] text-slate leading-relaxed max-w-md text-pretty">
          Thirty minutes, no obligation. Tell us what's going on and we'll tell you plainly how we'd
          approach it, including if we're not the right fit for it.
        </p>

        <div class="mt-10 space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-sand flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-indigo-deep" viewBox="0 0 20 20" fill="none">
                <path d="M3 5.5L10 11L17 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="3" y="4" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </div>
            <div>
              <p class="text-[14px] text-slate/60">Email</p>
              <a href={`mailto:${siteMeta.email}`} class="text-[15.5px] font-medium text-indigo-deep hover:text-orange-deep transition-colors">
                {siteMeta.email}
              </a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-sand flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-indigo-deep" viewBox="0 0 20 20" fill="none">
                <path d="M10 18s6-5.2 6-10a6 6 0 10-12 0c0 4.8 6 10 6 10z" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </div>
            <div>
              <p class="text-[14px] text-slate/60">Serving</p>
              <p class="text-[15.5px] font-medium text-indigo-deep">UK, US, Canada &amp; Nigeria</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-sand flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-indigo-deep" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10 6v4l2.5 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <p class="text-[14px] text-slate/60">Response time</p>
              <p class="text-[15.5px] font-medium text-indigo-deep">We aim to reply within two business days</p>
            </div>
          </div>
        </div>

        <a
          href={siteMeta.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-10 text-[14px] font-medium text-indigo-deep hover:text-orange-deep transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
          </svg>
          Connect on LinkedIn
        </a>
      </div>

      <div class="bg-sand rounded-2xl p-7 sm:p-9">
        <form id="contact-form" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">Full name</label>
              <input required type="text" id="name" name="name" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep placeholder:text-slate/40 focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange" placeholder="Amaka Obi" />
            </div>
            <div>
              <label for="email" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">Email</label>
              <input required type="email" id="email" name="email" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep placeholder:text-slate/40 focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange" placeholder="you@company.com" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="company" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">Business name</label>
              <input type="text" id="company" name="company" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep placeholder:text-slate/40 focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange" placeholder="Company Ltd" />
            </div>
            <div>
              <label for="location" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">Where are you based?</label>
              <input type="text" id="location" name="location" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep placeholder:text-slate/40 focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange" placeholder="London, UK" />
            </div>
          </div>

          <div>
            <label for="service" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">What do you need?</label>
            <select id="service" name="service" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange">
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="block text-[13.5px] font-medium text-indigo-deep mb-1.5">What's going on?</label>
            <textarea required id="message" name="message" rows="4" class="w-full rounded-lg border border-indigo-deep/15 bg-white px-4 py-3 text-[14.5px] text-indigo-deep placeholder:text-slate/40 focus:outline-none focus:ring-2 focus:ring-orange/50 focus:border-orange resize-none" placeholder="A sentence or two is fine. We'll ask follow-up questions on the call."></textarea>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 bg-orange text-indigo-deep font-medium text-[15px] px-6 py-3.5 rounded-full hover:bg-orange-deep transition-colors duration-200"
          >
            Send &amp; request a call
          </button>
          <p id="form-status" class="text-[13px] text-slate/60 text-center" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ email: siteMeta.email }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name');
    const company = data.get('company') || 'N/A';
    const location = data.get('location') || 'N/A';
    const service = data.get('service');
    const senderEmail = data.get('email');
    const message = data.get('message');

    const subject = encodeURIComponent(`Consultation request: ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${senderEmail}\nBusiness: ${company}\nLocation: ${location}\nInterested in: ${service}\n\nMessage:\n${message}`
    );

    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (status) status.textContent = 'Opening your email client to send this. Prefer not to? Email us directly.';
  });
</script>
