---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarHero from '../components/PillarHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PricingNote from '../components/PricingNote.astro';
import CTASection from '../components/CTASection.astro';

const included = [
  {
    title: 'Hiring & recruitment',
    body: 'For any role your business needs, not just traditional HR positions. If your business needs someone hired and managed, we can find and manage that person.',
  },
  {
    title: 'Payroll & pay management',
    body: 'We handle payroll for your team directly, so you’re not managing bank transfers or compliance yourself.',
  },
  {
    title: 'HR policy & documentation',
    body: 'Contracts, employee handbooks, and onboarding materials built for your business specifically, not a downloaded template.',
  },
  {
    title: 'Weekly check-ins',
    body: 'A standing cadence with your team, so problems surface on schedule, not as an 11pm phone call.',
  },
];

const whoFor = [
  {
    title: 'Based abroad',
    body: 'Your business is in the diaspora, but you need to employ a team in Nigeria, hired properly, with someone managing them day to day.',
  },
  {
    title: 'Running it alone',
    body: 'One person handling sales, staff, and everything in between, with no real HR structure and no time to build one.',
  },
  {
    title: 'Need outsourced HR',
    body: 'You already have a team, but no HR department, and hiring one just to manage payroll and people issues doesn’t make sense yet.',
  },
  {
    title: 'Already tried it, and it didn’t stick',
    body: 'You hired an in-house HR person before, but it didn’t work out, wrong fit, too expensive for what you needed, or they left and you’re back to square one.',
  },
];

const faqs = [
  {
    q: 'My business doesn’t feel like it needs HR. Is this still for us?',
    a: 'Probably, yes. Most businesses that think they don’t need HR still need someone hired and managed, whatever the role. We recruit across any function, not just traditional HR positions.',
  },
  {
    q: 'I already have staff. Can you just take over managing them?',
    a: 'Yes. We’ll scope where things stand today on the discovery call and take over payroll, policy, and management from there.',
  },
  {
    q: 'How do payroll payments work?',
    a: 'We handle payroll for your team directly, so you’re not managing bank transfers or compliance yourself.',
  },
];

const steps = [
  { title: 'Discovery call', body: 'We map your current team, structure, and where the people side of the business is actually breaking down.' },
  { title: 'People audit', body: 'A clear-eyed review of contracts, policy, and gaps, measured against what your business actually needs.' },
  { title: 'Embedded management', body: 'We take on day-to-day people operations for your African team, aligned to your working hours.' },
  { title: 'Monthly reporting', body: 'A straight readout of what happened with your team that month, and what actually needs your decision.' },
];
---
<BaseLayout
  title="Fractional HR & People Management for African Teams"
  description="Masy Consulting is a fractional HR partner for diaspora business owners. We manage the African team you can't physically oversee, from staff management to HR policy to recruitment."
>
  <PillarHero
    number="01"
    label="Fractional HR & People Management · Anchor service"
    title="A fractional HR partner for the team you can't"
    titleAccent="physically manage."
    lead="You run your business from the UK, US, or Canada. Your staff are on the ground in Nigeria or wherever your operations sit. Masy becomes your people function there: hiring, payroll, policy, and the day-to-day management that keeps a distributed team accountable, without you micromanaging from another continent."
    facts={[
      ['Engagement', 'Monthly retainer'],
      ['Scoped by', 'Team size & needs'],
      ['Payroll', 'Handled directly'],
      ['Working hours', 'Aligned to yours'],
      ['Reporting', 'Monthly, in writing'],
    ]}
  />

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div data-reveal>
      <Eyebrow num="01">What this covers</Eyebrow>
      <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
        Everything between "we hired someone" and "someone is actually managing them."
      </h2>
    </div>
    <div class="mt-12">
      <ServiceGrid items={included} />
    </div>
  </section>

  <section class="relative bg-ink text-white overflow-hidden dark-section">
    <div class="absolute inset-0 grain-overlay"></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28 relative">
      <div class="max-w-3xl" data-reveal>
        <Eyebrow light num="02">The gap no one else fills</Eyebrow>
        <p class="mt-7 font-display text-[clamp(1.7rem,3.8vw,2.9rem)] leading-[1.15] tracking-[-0.015em] text-balance">
          HR outsourcing firms sell compliance. UK fractional-HR firms sell boardroom strategy.
          <span class="text-orange">Nobody manages the actual team.</span>
        </p>
        <p class="mt-7 text-white/65 text-[16px] leading-relaxed max-w-2xl text-pretty">
          Almost no one sits in between: managing the people who work for a
          diaspora-owned business, in the country where they actually work, on
          the schedule of the person who owns the business. That's the
          specific, unglamorous gap Masy operates in. The daily work of running
          a team you can't walk over and check on.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div data-reveal>
      <Eyebrow num="03">Who this is for</Eyebrow>
      <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
        If any of this sounds familiar.
      </h2>
    </div>
    <div class="mt-12 grid sm:grid-cols-2 gap-5" data-reveal-stagger>
      {whoFor.map((item, i) => (
        <div class="rounded-[1.5rem] bg-white border border-ink/12 p-7 sm:p-8 flex flex-col gap-2.5">
          <span class="font-mono text-[12.5px] font-semibold text-slate/50">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-display font-bold text-[1.15rem] text-ink">{item.title}</h3>
          <p class="text-[14px] text-slate leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white border-y border-ink/10">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
      <div data-reveal>
        <Eyebrow num="04">How it works</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          From first call to a running retainer.
        </h2>
      </div>
      <div class="mt-14">
        <ProcessSteps steps={steps} />
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <PricingNote
      model="Fractional HR runs as a monthly retainer, scoped to the size of your team after a discovery call. Not a flat rate pulled from a card."
      points={[
        'Scoped after a discovery call, not a generic rate card',
        'Structured as a retainer, not one-off invoices',
        'Pricing confirmed in writing before work begins',
        'Scales as your team grows',
      ]}
    />
  </section>

  <section class="bg-paper">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
      <div data-reveal>
        <Eyebrow num="05">FAQ</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          Questions people ask before booking a call.
        </h2>
      </div>
      <div class="mt-12 max-w-[760px] border-t border-ink/10" data-reveal>
        {faqs.map((f) => (
          <details class="faq-item border-b border-ink/10">
            <summary class="flex items-center justify-between gap-5 py-6 px-1 cursor-pointer font-semibold text-[17px] tracking-[-0.01em] text-ink">
              {f.q}
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <p class="px-1 pb-6 text-[15px] text-slate leading-relaxed max-w-[640px]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Let's take this off your plate."
    body="Book a discovery call, or message us on WhatsApp, whichever's easier."
    primaryLabel="Book a discovery call"
    secondaryLabel="WhatsApp us"
    secondaryHref="/contact/"
  />
</BaseLayout>

<style>
  .faq-item summary {
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item .plus {
    flex: none;
    width: 22px;
    height: 22px;
    position: relative;
  }
  .faq-item .plus::before,
  .faq-item .plus::after {
    content: '';
    position: absolute;
    background: theme('colors.indigo.DEFAULT');
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }
  .faq-item .plus::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-item .plus::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq-item[open] .plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
</style>
