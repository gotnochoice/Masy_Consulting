---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import IconCardGrid from '../components/IconCardGrid.astro';
import PersonaGrid from '../components/PersonaGrid.astro';
import ProcessCards from '../components/ProcessCards.astro';
import FaqCards from '../components/FaqCards.astro';
import Button from '../components/Button.astro';

const included = [
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c1.5-4.5 5-6.5 8-6.5s6.5 2 8 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
    title: 'Hiring & recruitment',
    body: 'For any role your business needs, not just traditional HR positions. If your business needs someone hired and managed, we can find and manage that person.',
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18M8 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
    title: 'Payroll & pay management',
    body: 'We handle payroll for your team directly, so you’re not managing bank transfers or compliance yourself.',
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
    title: 'HR policy & documentation',
    body: 'The paperwork that protects both you and your team, set up properly from the start.',
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    title: 'Weekly check-ins',
    body: 'A standing cadence with your team, so problems surface on schedule, not as an 11pm phone call.',
  },
];

const whoFor = [
  {
    title: 'Based abroad',
    body: 'Your business is in the diaspora, but you need to employ a team in Nigeria, hired properly, with someone managing them day to day.',
  },
  {
    title: 'Running it alone',
    body: 'One person handling sales, staff, and everything in between, with no real HR structure and no time to build one.',
  },
  {
    title: 'Need outsourced HR',
    body: 'You already have a team, but no HR department, and hiring one just to manage payroll and people issues doesn’t make sense yet.',
  },
  {
    title: 'Already tried it, and it didn’t stick',
    body: 'You hired an in-house HR person before, but it didn’t work out, wrong fit, too expensive for what you needed, or they left and you’re back to square one.',
  },
];

const steps = [
  { title: 'Book a discovery call', body: 'Tell us about your team, or the team you need to build.' },
  { title: 'We scope it', body: 'You get exactly what we’ll manage and what it costs, no long contracts.' },
  { title: 'We get to work', body: 'Hiring, payroll, and policy set up, or taken over from where you are today.' },
  { title: 'You stay updated', body: 'Weekly check-ins, so you’re never wondering what’s happening.' },
];

const faqs = [
  {
    q: 'My business doesn’t feel like it needs HR. Is this still for us?',
    a: 'Probably, yes. Most businesses that think they don’t need HR still need someone hired and managed, whatever the role. We recruit across any function, not just traditional HR positions.',
  },
  {
    q: 'I already have staff. Can you just take over managing them?',
    a: 'Yes. We’ll scope where things stand today on the discovery call and take over payroll, policy, and management from there.',
  },
  {
    q: 'How do payroll payments work?',
    a: 'We handle payroll for your team directly, so you’re not managing bank transfers or compliance yourself.',
  },
];
---
<BaseLayout
  title="Fractional HR & People Management for African Teams"
  description="Masy Consulting is a fractional HR partner for diaspora business owners. We hire, pay, and manage the African team you can't physically oversee."
>
  <section class="relative h-[600px] sm:h-[620px] overflow-visible">
    <img
      src="/two.jpg"
      alt="An HR manager reviewing and annotating staff documents at his desk"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(20,10,69,0.4) 0%, rgba(20,10,69,0.76) 100%);"></div>

    <div class="relative z-[2] h-full max-w-content mx-auto px-5 sm:px-8 flex flex-col items-center justify-center text-center">
      <p class="font-mono text-[12.5px] font-semibold uppercase tracking-[0.06em] text-orange-light flex items-center justify-center gap-2 mb-5">
        <span class="w-5 h-px bg-current inline-block"></span>
        Fractional HR & People Management
        <span class="w-5 h-px bg-current inline-block"></span>
      </p>
      <h1 class="text-white font-display font-extrabold text-[clamp(1.9rem,4.4vw,3.3rem)] leading-[1.12] tracking-[-0.03em] max-w-[min(760px,90%)] mb-5 text-balance">
        Your team, <span class="text-orange-light">managed and paid</span>, whether you're here or not.
      </h1>
      <p class="text-[#E4E1F0] text-[17px] leading-[1.55] max-w-[min(560px,90%)] mb-8 text-pretty">
        Masy hires, pays, and manages your team, whether you're running things from abroad or trying to juggle it all yourself with a small team here in Nigeria.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-4">
        <Button href="/contact/" variant="primary">Book a discovery call</Button>
        <Button href="/contact/" variant="outlineDark">WhatsApp us</Button>
      </div>
    </div>

    <div class="hero-fact-card absolute left-1/2 -translate-x-1/2 -bottom-9 z-[3] bg-white rounded-[12px] px-7 py-5 flex items-center gap-[18px] shadow-[0_30px_60px_-24px_rgba(20,10,69,0.35)] w-[88%] sm:w-auto">
      <span class="font-mono font-bold text-[28px] text-indigo shrink-0">4</span>
      <span class="w-px h-[34px] bg-ink/10 shrink-0"></span>
      <p class="text-[13px] text-slate leading-[1.3] text-left max-w-[220px]">Timezones covered: UK, US, Canada, and Nigeria, wherever you're based, the process doesn't change.</p>
    </div>
  </section>

  <section class="pt-[120px] pb-20 sm:pb-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div data-reveal>
        <Eyebrow num="01">What's included</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          Everything it takes to run people, handled.
        </h2>
        <p class="mt-4 text-[15.5px] text-slate max-w-xl leading-relaxed text-pretty">
          Not just the paperwork, the actual day-to-day of having a team. The same team manages your account every week, not a rotating cast of freelancers.
        </p>
      </div>
      <div class="mt-12">
        <IconCardGrid items={included} columns={2} />
      </div>
    </div>
  </section>

  <section class="bg-paper-2 py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div data-reveal>
        <Eyebrow num="02">Who this is for</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          If any of this sounds familiar.
        </h2>
      </div>
      <div class="mt-12">
        <PersonaGrid items={whoFor} />
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div data-reveal>
        <Eyebrow num="03">How it works</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          Four steps, start to finish.
        </h2>
      </div>
      <div class="mt-12">
        <ProcessCards steps={steps} />
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="text-center max-w-[640px] mx-auto mb-10" data-reveal>
        <Eyebrow class="justify-center">FAQ</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.7rem,3vw,2.3rem)] text-ink">
          Questions people ask before booking a call.
        </h2>
      </div>
      <FaqCards items={faqs} />
    </div>
  </section>

  <section id="contact" class="py-14 sm:py-[88px]">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="cta-band bg-ink rounded-[20px] px-6 py-11 sm:px-[52px] sm:py-16 relative overflow-hidden" data-reveal>
        <div class="max-w-[600px] mx-auto text-center relative z-[1]">
          <h2 class="font-display font-extrabold text-[clamp(1.9rem,3.8vw,2.8rem)] leading-[1.1] tracking-[-0.03em] text-white mb-4">
            Let's take this off your plate.
          </h2>
          <p class="text-[15.5px] text-[#B9B4C9] leading-[1.65] mb-8">
            Book a discovery call, or message us on WhatsApp, whichever's easier.
          </p>
          <div class="flex flex-wrap justify-center items-center gap-4">
            <Button href="/contact/" variant="primary">Book a discovery call</Button>
            <Button href="/contact/" variant="outlineDark">WhatsApp us</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bg-paper-2 {
    background: #f7f5f0;
  }
  .hero-fact-card {
    animation: cardIn 0.7s var(--ease-out-expo) 0.5s both;
  }
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(16px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }
  .cta-band::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -60px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251, 150, 31, 0.16) 0%, transparent 70%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fact-card {
      animation: none;
      opacity: 1;
    }
  }
</style>
