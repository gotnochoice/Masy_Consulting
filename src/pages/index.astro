---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { siteMeta } from '../data/site';

const heroSlides = [
  { src: '/four.jpg', alt: 'A consultant writing in a notebook beside her laptop and financial charts' },
  { src: '/two.jpg', alt: 'An HR manager reviewing and annotating a staff schedule at his desk' },
  { src: '/three.jpg', alt: 'A consultant reviewing and stamping documents at a conference table' },
];

const traitGroups = [
  {
    title: 'Running things locally',
    traits: [
      'You’ve hired one or two people, and the business needs more hands than you can manage yourself.',
      'You’re not ready for a full HR department, you’re still building.',
      'You’d rather one team already knew your business than explain it to a new vendor every time.',
      'You’re the one settling every staff disagreement, and it’s eating into time you don’t have.',
      'You don’t have a real system for knowing whether the work actually got done each week.',
      'You’re paying staff manually, and it’s quietly become its own weekly task.',
    ],
  },
  {
    title: 'Watching from a distance',
    traits: [
      'You’re running a Nigeria-based team from another country and can’t check on it yourself.',
      'You want to know the work got done. Not hope it did.',
      'A phone call only tells you so much, you need someone actually watching.',
      'You haven’t set up local payment rails yet, so paying staff is its own headache.',
      'You need a proposal, research, or a projection built properly, and you’re not around to manage it.',
      'You want one point of contact who knows your whole operation, not five people each holding a piece of it.',
    ],
  },
];

const traitCount = traitGroups.reduce((n, g) => n + g.traits.length, 0);

const yourTeamServices = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 014-4h6a4 4 0 014 4v2"/><path d="M16 3.13a4 4 0 010 7.75"/><path d="M22 21v-2a4 4 0 00-3-3.87"/></svg>',
    title: 'Hiring & Recruitment',
    body: 'Sifting CVs and running interviews isn’t where your time should go. We advertise the role, screen and interview candidates, draft the staff contract, and bring the right person on, so you only meet the ones worth meeting.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>',
    title: 'Weekly Accountability',
    body: 'You shouldn’t have to wonder if the work actually got done this week. We track it and check in, so you always know without having to ask.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>',
    title: 'Conflict Resolution',
    body: 'Staff disagreements cost you time and patience you don’t have. We step in and settle it, before it lands on your desk.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>',
    title: 'Staff Logistics',
    body: 'A staff phone, a data plan, a small request that keeps getting pushed back. We handle it, so it’s one less thing sitting on your list.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>',
    title: 'Payroll Disbursement',
    body: 'Payday shouldn’t be something you have to remember and chase every month. We disburse on time, under our name, so it’s just handled.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
    title: 'Operations Management',
    body: 'The random asks that come with a growing team, sourcing equipment, running an errand, getting something from one place to another. We take care of it.',
  },
];

const doorServices = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6M9 11h6"/></svg>',
    title: 'Proposals',
    body: 'The proposal that could win you a client shouldn’t be sitting half-written in your drafts. We write it client-ready, on your timeline.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>',
    title: 'Research',
    body: 'Before you enter a market or take on a client, you need to know what you’re actually walking into. We do the digging, you make the call.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>',
    title: 'Financial Projections & Budgets',
    body: 'A client asks for a projection and suddenly you need real numbers by tomorrow. We build them properly, so you’re never caught without.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
    title: 'Pitch Decks',
    body: 'Getting in the room with an investor or a big client takes more than a few slides thrown together. We build a deck made to be pitched, not just read.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-3"/><path d="M9 12h6M9 16h6"/></svg>',
    title: 'Business Plans',
    body: 'A loan or grant application wants a real business plan, not a paragraph explaining your idea. We build it the way reviewers actually expect to see it.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="4" width="3" height="14"/></svg>',
    title: 'Reports',
    body: 'Clients and partners expect regular updates, and writing them shouldn’t be your 11pm task. We handle it, on schedule, every time.',
  },
];

const caseStudies = [
  {
    kicker: 'Fashion & Events',
    loc: 'USA · Sole proprietor',
    body: 'Started with one virtual assistant to help run a US-based fashion, events, makeup, and tailoring business. As the work outgrew one person, we hired a brand strategist, a graphic designer, and a video editor, and now manage the full team’s day-to-day, from performance to settling staff issues.',
    tags: ['Hiring', 'Team management', 'Weekly accountability'],
  },
  {
    kicker: 'Real Estate',
    loc: 'Nigeria · 2 years old',
    body: 'A young real estate company that didn’t want the overhead of an in-house HR hire. We hired their receptionist, admin, video editor, and graphic designer, handle staff disbursement and day-to-day issues, and just built a financial projection for one of their live projects.',
    tags: ['Hiring', 'Disbursement', 'Financial projections'],
  },
];

const processSteps = [
  {
    title: 'Discovery call',
    body: 'We talk through what’s actually breaking, not a sales pitch, a real conversation about where the operations are slipping.',
  },
  {
    title: 'Scoped plan',
    body: 'You get a clear plan naming what we handle, what it costs, and how often you’ll hear from us.',
  },
  {
    title: 'We get to work',
    body: 'One named team runs it, with a reporting cadence you can actually rely on.',
  },
];

const faqs = [
  {
    q: 'What makes Masy different from a regular HR agency or a freelance VA?',
    a: 'We don’t just place someone and step away. We manage the actual weekly work: performance, conflict, logistics, and payroll, plus whatever needs to go out the door in writing. One team handling both, not a placement service you have to manage yourself afterward.',
  },
  {
    q: 'Do we need an ongoing relationship, or can this be a one-off?',
    a: 'Both work. Some clients bring us in for a single proposal, a research piece, or a projection. Most relationships grow into something ongoing once the first piece of work is done well, but there’s no obligation either way.',
  },
  {
    q: 'How does payroll actually work? Are you handling our money?',
    a: 'We disburse staff pay on your behalf, under our name, on a schedule agreed upfront with you. You approve the payroll amount each cycle; we handle getting it to your team on time, so payday isn’t something you have to remember and chase.',
  },
  {
    q: 'What if we already have someone doing some of this?',
    a: 'Tell us what’s already covered on the discovery call. We scope around it rather than replacing what’s already working.',
  },
];
---
<BaseLayout
  title="Masy Consulting — You Run the Business. We Run Everything Underneath."
  description="Masy Consulting hires and manages your team, and writes and builds the proposals, research, projections, and decks that go out the door, so you can focus on the business instead of running it."
>
  <section class="hero relative min-h-screen flex items-end overflow-hidden" style="background: linear-gradient(160deg, #281398 0%, #180B5E 100%);">
    {heroSlides.map((slide, i) => (
      <div class:list={['hero-slide absolute inset-0', { active: i === 0 }]} data-hslide={i}>
        <img src={slide.src} alt={slide.alt} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
        <div class="absolute inset-0" style="background: linear-gradient(0deg, rgba(21,10,66,0.85) 0%, rgba(21,10,66,0.5) 45%, rgba(21,10,66,0.2) 100%);"></div>
      </div>
    ))}

    <div class="relative z-[2] max-w-content mx-auto w-full px-5 sm:px-8 pb-16 sm:pb-[72px] text-center">
      <h1 class="text-white font-extrabold text-[clamp(2.4rem,6vw,4.6rem)] leading-[1.1] tracking-[-0.02em] max-w-[840px] mx-auto mb-5 min-h-[1.1em]">
        <span id="typeContent"></span><span class="type-cursor" id="typeCursor"></span>
      </h1>
      <p class="hero-sub fade-in text-white/85 text-[17.5px] leading-[1.55] max-w-[520px] mx-auto mb-8" id="heroSub">
        Your team, your paperwork, your numbers, handled by one team, whether you're in Lagos or watching from abroad.
      </p>
      <div class="hero-cta fade-in flex gap-3.5 flex-wrap items-center justify-center" id="heroCta">
        <Button href="/#book" variant="primary" size="lg" pill={false}>Book a discovery call</Button>
        <Button href={siteMeta.whatsappUrl} variant="outlineDark" size="lg" pill={false} newTab>WhatsApp us</Button>
      </div>
    </div>

    <div class="hero-dots absolute bottom-7 right-8 z-[3] flex gap-2" id="heroDots"></div>
  </section>

  <section class="whofor2 py-16 sm:py-20 max-w-content mx-auto px-5 sm:px-8" id="whofor">
    <div class="max-w-[640px] mx-auto mb-9 text-center" id="whoforHead">
      <span class="block text-orange text-[13px] tracking-[0.08em] uppercase font-extrabold mb-4">Who this is for</span>
      <h2 class="font-extrabold text-[clamp(1.75rem,3.8vw,2.75rem)] tracking-[-0.02em] leading-[1.15] text-ink min-h-[1.15em]">
        <span id="typeContent2"></span><span class="type-cursor" id="typeCursor2"></span>
      </h2>
    </div>

    <div class="max-w-[340px] mx-auto mb-10 px-6 py-4 bg-indigo rounded-lg flex items-center justify-center gap-2.5 text-white text-[14.5px] font-bold">
      <span>Tap what sounds like you</span>
      <span>·</span>
      <span><span class="text-orange-light text-[19px] font-extrabold" id="traitCount">0</span> of {traitCount}</span>
    </div>

    {traitGroups.map((group) => (
      <div class="mb-10 last:mb-0">
        <div class="flex items-center gap-3.5 mb-7">
          <span class="trait-mark w-5 h-[26px] relative shrink-0" aria-hidden="true"></span>
          <h3 class="font-extrabold text-[24px] tracking-[-0.01em] text-indigo">{group.title}</h3>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal-stagger>
          {group.traits.map((trait) => (
            <button type="button" class="trait-card text-left bg-white rounded-xl p-6 flex gap-3.5 items-start border-[1.5px] border-ink/[0.06] shadow-[0_2px_8px_rgba(15,15,15,0.04),0_10px_26px_-14px_rgba(15,15,15,0.1)] transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:shadow-[0_4px_12px_rgba(15,15,15,0.06),0_20px_36px_-16px_rgba(15,15,15,0.18)] hover:border-ink/[0.12]">
              <span class="trait-check w-[30px] h-[30px] rounded-lg bg-indigo-tint flex items-center justify-center shrink-0 transition-all duration-300 ease-out-quart">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-[15px] h-[15px] stroke-indigo opacity-30 transition-opacity duration-200"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <p class="text-[14.5px] font-semibold text-ink leading-[1.45] pt-1 transition-colors duration-200">{trait}</p>
            </button>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="groups py-16 sm:py-20 border-t border-line" id="groups">
    <div class="max-w-[640px] mx-auto mb-10 px-5 text-center">
      <span class="block text-orange text-[12.5px] tracking-[0.08em] uppercase font-extrabold mb-3.5">Everything underneath</span>
      <h2 class="font-extrabold text-[clamp(1.75rem,3.8vw,2.9rem)] tracking-[-0.02em] leading-[1.15] text-ink mb-3.5">Two things stop landing on your desk.</h2>
      <p class="text-slate text-[16px] leading-[1.6]">Not services picked off a menu. Everything below is part of the same job, keeping the business running while you focus on the business.</p>
    </div>

    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="mb-10">
        <div class="flex items-center gap-3.5 mb-8">
          <span class="trait-mark w-5 h-[26px] relative shrink-0" aria-hidden="true"></span>
          <h3 class="font-extrabold text-[26px] tracking-[-0.01em] text-indigo">Your Team</h3>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-stagger>
          {yourTeamServices.map((s) => (
            <div class="svc-card group relative bg-white rounded-xl p-8 pb-7 border border-ink/[0.06] shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(15,15,15,0.12)] transition-all duration-300 ease-out-quart hover:-translate-y-2 hover:border-ink/[0.15] hover:shadow-[0_4px_14px_rgba(15,15,15,0.06),0_28px_50px_-20px_rgba(15,15,15,0.28)] overflow-hidden">
              <span class="svc-card-bar absolute top-0 left-0 right-0 h-[3px] scale-x-0 origin-left transition-transform duration-[400ms] ease-out-quart" style="background: linear-gradient(90deg, #FB961F, #281398);" aria-hidden="true"></span>
              <span class="svc-icon w-[46px] h-[46px] rounded-[10px] bg-indigo-tint flex items-center justify-center mb-5 transition-all duration-300 ease-out-quart group-hover:bg-indigo group-hover:-rotate-[8deg] group-hover:scale-[1.06]" set:html={s.icon.replace('<svg ', '<svg class="w-[22px] h-[22px] stroke-indigo group-hover:stroke-white transition-colors duration-300" ')} />
              <h4 class="font-extrabold text-[20px] text-indigo mb-3 leading-[1.25] tracking-[-0.008em] transition-colors duration-200 group-hover:text-indigo-light">{s.title}</h4>
              <p class="text-[14.5px] text-slate leading-[1.6]">{s.body}</p>
              <div class="flex items-center justify-between mt-6">
                <span class="text-[12px] font-extrabold tracking-[0.06em] uppercase text-indigo">Book a call</span>
                <a href="/#book" aria-label={`Book a call about ${s.title}`} class="svc-arrow w-[42px] h-[42px] rounded-lg bg-orange flex items-center justify-center shrink-0 transition-transform duration-300 ease-out-quart group-hover:scale-[1.12] group-hover:rotate-[360deg]">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="2.4" stroke-linecap="round" class="w-4 h-4 transition-transform duration-300 ease-out-quart group-hover:rotate-45"><path d="M7 17L17 7M9 7h8v8"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
        <div class="flex items-center gap-5 bg-indigo rounded-xl px-7 py-6 mt-6 flex-col sm:flex-row text-left">
          <span class="w-11 h-11 rounded-[10px] bg-white/[0.14] flex items-center justify-center shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-[22px] h-[22px]"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </span>
          <p class="text-[14.5px] text-white/85 leading-[1.5]"><strong class="text-white">You get to see it, not just take our word for it.</strong> Every client is onboarded onto our HR platform, one place to see the team roster, performance reviews, and payment records as they happen.</p>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3.5 mb-8">
          <span class="trait-mark w-5 h-[26px] relative shrink-0" aria-hidden="true"></span>
          <h3 class="font-extrabold text-[26px] tracking-[-0.01em] text-indigo">What Goes Out the Door</h3>
        </div>
        <div class="divide-y divide-line" data-reveal-stagger>
          {doorServices.map((s) => (
            <div class="svc-row group flex items-start gap-5 py-6 pl-4 border-l-[3px] border-transparent transition-all duration-300 ease-out-quart hover:border-orange hover:pl-6">
              <span class="svc-row-icon w-10 h-10 rounded-lg bg-indigo-tint flex items-center justify-center shrink-0 transition-colors duration-300 ease-out-quart group-hover:bg-indigo" set:html={s.icon.replace('<svg ', '<svg class="w-[19px] h-[19px] stroke-indigo group-hover:stroke-white transition-colors duration-300" ')} />
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between gap-4 flex-wrap">
                  <h4 class="font-extrabold text-[17px] text-indigo tracking-[-0.005em]">{s.title}</h4>
                  <a href="/#book" aria-label={`Book a call about ${s.title}`} class="shrink-0 text-[12px] font-extrabold tracking-[0.06em] uppercase text-indigo/60 group-hover:text-orange-deep transition-colors duration-200">Book a call →</a>
                </div>
                <p class="text-[14.5px] text-slate leading-[1.6] mt-1.5 max-w-[560px]">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="text-center text-[13.5px] text-slate mt-8">Also available on request, quoted separately: business registration support.</p>
      </div>
    </div>
  </section>

  <section class="about py-16 sm:py-20 bg-[#F7F5F0]" id="about">
    <div class="max-w-[1160px] mx-auto px-5 sm:px-8 grid md:grid-cols-[1.1fr_0.9fr] gap-16 items-center">
      <div class="order-2 md:order-1">
        <span class="trait-mark w-10 h-[52px] relative block mb-7" aria-hidden="true" style="--mark-w: 12px; --mark-gap: 22px;"></span>
        <h2 class="font-extrabold text-[clamp(1.9rem,4vw,2.75rem)] tracking-[-0.02em] leading-[1.15] text-ink mb-6">We didn't set out to build a service menu.</h2>
        <p class="text-[17px] leading-[1.7] text-slate max-w-[560px] mb-5">Masy Consulting started the way most real businesses do, by solving one problem for one client, then staying because the work kept growing. A single hire turned into a team. A one-off request turned into an ongoing relationship. That pattern is now the whole business.</p>
        <p class="text-[17px] leading-[1.7] text-slate max-w-[560px]">We're not a large firm pretending to be small, or a solo consultant pretending to be a firm. We're a hands-on team that shows up in the actual weekly work, hiring, monitoring, paying staff, writing what needs to go out the door, not just advising from a distance.</p>
      </div>
      <div class="order-1 md:order-2 relative rounded-xl overflow-hidden aspect-[4/5] shadow-[0_20px_50px_-20px_rgba(15,15,15,0.18)]">
        <img src="/one.jpg" alt="Five members of the Masy Consulting team working through a plan together around a laptop" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="examples py-16 sm:py-20 bg-white border-y border-line" id="examples">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="max-w-[640px] mx-auto mb-9 text-center">
        <span class="block text-orange text-[12.5px] tracking-[0.08em] uppercase font-extrabold mb-3.5">Not hypothetical, already happening</span>
        <h2 class="font-extrabold text-[clamp(1.75rem,3.8vw,2.9rem)] tracking-[-0.02em] leading-[1.15] text-ink">Two businesses we're running the operations for right now.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5" data-reveal-stagger>
        {caseStudies.map((c) => (
          <div class="bg-white rounded-xl p-9 border border-ink/[0.06] shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(15,15,15,0.12)] transition-all duration-300 ease-out-quart hover:-translate-y-1.5 hover:shadow-[0_4px_14px_rgba(15,15,15,0.06),0_24px_44px_-18px_rgba(15,15,15,0.18)]">
            <div class="flex justify-between items-baseline mb-4.5 gap-3 flex-wrap">
              <span class="text-[14px] font-extrabold text-indigo">{c.kicker}</span>
              <span class="text-[13px] text-slate-light font-semibold">{c.loc}</span>
            </div>
            <p class="text-[15.5px] text-slate leading-[1.65] mb-5">{c.body}</p>
            <div class="flex flex-wrap gap-2.5">
              {c.tags.map((tag) => (
                <span class="text-[13px] font-bold text-indigo border-[1.5px] border-indigo rounded-lg px-3.5 py-1.5">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-[14px] text-slate mt-9">Two of the businesses we currently run operations for, among others we're working with.</p>
    </div>
  </section>

  <section class="process py-16 sm:py-20" id="process">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="max-w-[520px] mb-10">
        <span class="block text-orange text-[12.5px] tracking-[0.08em] uppercase font-extrabold mb-3.5">How it works</span>
        <h2 class="font-extrabold text-[clamp(1.75rem,3.8vw,2.9rem)] tracking-[-0.02em] leading-[1.15] text-ink">Three steps, no fluff.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6" data-reveal-stagger>
        {processSteps.map((step, i) => (
          <div class="bg-white rounded-xl p-8 border border-indigo/[0.06] shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(40,19,152,0.12)] transition-all duration-300 ease-out-quart hover:-translate-y-1.5 hover:shadow-[0_4px_14px_rgba(15,15,15,0.06),0_24px_44px_-18px_rgba(40,19,152,0.24)]">
            <span class="w-11 h-11 rounded-lg bg-orange text-ink flex items-center justify-center font-extrabold text-[16px] mb-5">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-extrabold text-[19px] text-ink mb-2.5">{step.title}</h3>
            <p class="text-[14.5px] text-slate leading-[1.6]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq py-16 sm:py-20 bg-[#F7F5F0]" id="faq">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="max-w-[640px] mx-auto mb-9 text-center">
        <span class="block text-orange text-[12.5px] tracking-[0.08em] uppercase font-extrabold mb-3.5">Questions worth asking</span>
        <h2 class="font-extrabold text-[clamp(1.75rem,3.8vw,2.9rem)] tracking-[-0.02em] leading-[1.15] text-ink">Before you book the call.</h2>
      </div>
      <div class="max-w-[720px] mx-auto flex flex-col gap-3" data-reveal>
        {faqs.map((f) => (
          <details class="faq-item bg-white rounded-xl border border-ink/[0.06] shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(15,15,15,0.12)] overflow-hidden">
            <summary class="list-none cursor-pointer flex items-center justify-between gap-5 px-7 py-5 font-extrabold text-ink text-[16px]">
              {f.q}
              <span class="faq-plus shrink-0"></span>
            </summary>
            <p class="px-7 pb-6 text-[14.5px] text-slate leading-[1.6] max-w-[600px]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing py-16 sm:py-20 text-center bg-indigo" id="book">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <h2 class="text-white font-extrabold text-[clamp(1.9rem,4.4vw,3.2rem)] tracking-[-0.02em] leading-[1.12] mb-4.5 max-w-[800px] mx-auto">Stop being your own operations department.</h2>
      <p class="text-white/75 text-[17px] font-medium mb-9">One free discovery call, no obligation, no pitch deck.</p>
      <Button href={siteMeta.whatsappUrl} variant="primary" size="lg" pill={false} newTab>Book a discovery call</Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero slideshow ---------- */
  .hero-slide {
    opacity: 0;
    transition: opacity 1s ease;
  }
  .hero-slide.active {
    opacity: 1;
  }
  .hero-dots :global(button) {
    width: 26px;
    height: 3px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: 2px;
    transition: background 0.2s ease;
  }
  .hero-dots :global(button.active) {
    background: var(--orange, #fb961f);
  }
  .fade-in {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .fade-in.show {
    opacity: 1;
  }
  .type-cursor {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    background: #fb961f;
    margin-left: 3px;
    vertical-align: -0.1em;
    animation: blink 0.85s steps(1) infinite;
  }
  .type-cursor.done {
    opacity: 0;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.quill-wrap) {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: #fb961f;
    font-weight: 700;
  }
  :global(.quill-underline) {
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 12px;
    overflow: visible;
    pointer-events: none;
  }
  :global(.quill-underline path) {
    fill: none;
    stroke: #fb961f;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.quill-underline.draw path) {
    stroke-dashoffset: 0;
  }

  /* ---------- "Your Team" / "What Goes Out the Door" section marks ---------- */
  .trait-mark {
    --mark-w: 6px;
    --mark-gap: 11px;
  }
  .trait-mark::before,
  .trait-mark::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--mark-w);
    background: var(--orange, #fb961f);
    transform: skewX(-14deg);
  }
  .trait-mark::before {
    left: 0;
    background: var(--indigo, #281398);
  }
  .trait-mark::after {
    left: var(--mark-gap);
  }

  /* ---------- Trait card checked state ---------- */
  .trait-card.checked {
    background: #281398;
    border-color: #281398;
  }
  .trait-card.checked p {
    color: #fff;
  }
  .trait-card.checked .trait-check {
    background: #fb961f;
    transform: scale(1.15) rotate(-8deg);
  }
  .trait-card.checked .trait-check svg {
    opacity: 1;
    stroke: #151515;
  }

  /* ---------- Service card top bar reveal on hover ---------- */
  .svc-card:hover .svc-card-bar {
    transform: scaleX(1);
  }

  /* ---------- FAQ plus/minus ---------- */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-plus {
    width: 22px;
    height: 22px;
    position: relative;
  }
  .faq-plus::before,
  .faq-plus::after {
    content: '';
    position: absolute;
    background: #281398;
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }
  .faq-plus::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-plus::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq-item[open] .faq-plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      opacity: 1;
      transition: none;
    }
    .type-cursor {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ---------- Hero slideshow ----------
    (() => {
      const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
      const dotsWrap = document.getElementById('heroDots');
      if (!slides.length || !dotsWrap) return;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        if (i === 0) dot.classList.add('active');
        dot.addEventListener('click', () => {
          show(i);
          resetTimer();
        });
        dotsWrap.appendChild(dot);
      });
      const dots = dotsWrap.querySelectorAll('button');

      function show(i: number) {
        slides.forEach((s, idx) => s.classList.toggle('active', idx === i));
        dots.forEach((d, idx) => d.classList.toggle('active', idx === i));
        current = i;
      }
      function next() {
        show((current + 1) % slides.length);
      }
      function resetTimer() {
        if (reduceMotion) return;
        clearInterval(timer);
        timer = setInterval(next, 5500);
      }
      resetTimer();
    })();

    // ---------- Typewriter with quill underline (reusable) ----------
    type TypeSegment = { text: string; em: boolean };

    function runTypewriter(
      target: HTMLElement,
      cursor: HTMLElement,
      segments: TypeSegment[],
      onDone?: () => void
    ) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion) {
        segments.forEach((seg) => {
          if (seg.em) {
            const wrap = document.createElement('span');
            wrap.className = 'quill-wrap';
            wrap.textContent = seg.text;
            target.appendChild(wrap);
          } else {
            target.appendChild(document.createTextNode(seg.text));
          }
        });
        cursor.classList.add('done');
        onDone?.();
        return;
      }

      let segIdx = 0;
      let charIdx = 0;
      let currentEl: HTMLElement | null = null;
      let emTarget: HTMLElement | null = null;

      function step() {
        if (segIdx >= segments.length) {
          cursor.classList.add('done');
          const quillWrap = target.querySelector<HTMLElement>('.quill-wrap');
          if (quillWrap) {
            const ns = 'http://www.w3.org/2000/svg';
            const svg = document.createElementNS(ns, 'svg');
            svg.setAttribute('class', 'quill-underline');
            svg.setAttribute('viewBox', '0 0 140 14');
            svg.setAttribute('preserveAspectRatio', 'none');
            const path = document.createElementNS(ns, 'path');
            path.setAttribute('d', 'M2,10 C30,2 90,14 138,4');
            svg.appendChild(path);
            quillWrap.appendChild(svg);
            setTimeout(() => svg.classList.add('draw'), 150);
          }
          onDone?.();
          return;
        }
        const seg = segments[segIdx];
        if (charIdx === 0) {
          currentEl = document.createElement('span');
          if (seg.em) {
            currentEl.className = 'quill-wrap';
            const inner = document.createElement('em');
            inner.style.fontStyle = 'italic';
            currentEl.appendChild(inner);
            emTarget = inner;
          }
          target.appendChild(currentEl);
        }
        if (seg.em && emTarget) {
          emTarget.textContent += seg.text[charIdx];
        } else if (currentEl) {
          currentEl.textContent += seg.text[charIdx];
        }
        charIdx++;
        if (charIdx >= seg.text.length) {
          segIdx++;
          charIdx = 0;
        }
        setTimeout(step, 28 + Math.random() * 30);
      }
      setTimeout(step, 400);
    }

    // ---------- Hero headline ----------
    (() => {
      const target = document.getElementById('typeContent');
      const cursor = document.getElementById('typeCursor');
      const heroSub = document.getElementById('heroSub');
      const heroCta = document.getElementById('heroCta');
      if (!target || !cursor || !heroSub || !heroCta) return;

      runTypewriter(
        target,
        cursor,
        [
          { text: 'You run the business. We run ', em: false },
          { text: 'everything', em: true },
          { text: ' underneath.', em: false },
        ],
        () => {
          heroSub.classList.add('show');
          heroCta.classList.add('show');
        }
      );
    })();

    // ---------- "Who This Is For" headline: type on scroll into view ----------
    (() => {
      const target = document.getElementById('typeContent2');
      const cursor = document.getElementById('typeCursor2');
      const head = document.getElementById('whoforHead');
      if (!target || !cursor || !head) return;

      let started = false;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !started) {
              started = true;
              runTypewriter(target, cursor, [
                { text: 'If any of this sounds like you, keep reading.', em: false },
              ]);
              observer.disconnect();
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );
      observer.observe(head);
    })();

    // ---------- Trait cards: click to check + live counter ----------
    (() => {
      const traits = document.querySelectorAll('.trait-card');
      const countEl = document.getElementById('traitCount');
      if (!traits.length) return;
      function updateCount() {
        const checked = document.querySelectorAll('.trait-card.checked').length;
        if (countEl) countEl.textContent = String(checked);
      }
      traits.forEach((card) => {
        card.addEventListener('click', () => {
          card.classList.toggle('checked');
          updateCount();
        });
      });
    })();
  });
</script>
