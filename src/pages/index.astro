---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlides from '../components/HeroSlides.astro';
import Marker from '../components/Marker.astro';
import Button from '../components/Button.astro';

const problems = [
  {
    num: '01',
    title: 'Deals die on paper',
    body: 'The work is excellent. The proposal describing it isn’t. Somewhere between your ability and your documents, the contract goes quiet.',
  },
  {
    num: '02',
    title: 'A team you can’t see',
    body: 'Your staff are in Lagos. You’re in London. Policy lives in someone’s head, and problems surface as 11pm phone calls instead of Tuesday check-ins.',
  },
  {
    num: '03',
    title: 'Decisions made on instinct',
    body: 'You’re entering a market or backing a call on gut feel, because the research that should inform it was priced for multinationals, not for you.',
  },
];

const pillarCards = [
  {
    idx: '01',
    href: '/fractional-hr/',
    accent: '#281398',
    title: 'Fractional HR & People Management',
    body: 'You run the business from the UK or US. We manage your African team on the ground, hiring, pay, and weekly check-ins, so you don’t have to.',
    tag: 'Monthly retainer',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c1.5-4.5 5-6.5 8-6.5s6.5 2 8 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  },
  {
    idx: '02',
    href: '/business-writing/',
    accent: '#FB961F',
    title: 'Business Writing',
    body: 'Proposals, pitch decks, and reports that carry the same quality as the business behind them, ready to hold up in front of investors or partners.',
    tag: 'Per document',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  },
  {
    idx: '03',
    href: '/industry-analysis/',
    accent: '#2F32D5',
    title: 'Industry Analysis & Market Surveys',
    body: 'Grounded research for the market you’re about to enter, so the decision riding on it is backed by real data, not guesswork.',
    tag: 'Per project',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.8"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
];

const whoFeatured = [
  {
    idx: '01',
    title: 'Based abroad',
    body: 'Your business is in the diaspora, but you need to employ a team in Nigeria. You want good people, hired properly, with someone managing them for you day to day, not trying to coordinate it all yourself from a different country.',
  },
  {
    idx: '02',
    title: 'Running it alone',
    body: 'One person handling sales, staff, and everything in between, with no real HR structure and no time to build one, just trying to keep the team coordinated while still running the business itself.',
  },
];

const steps = [
  {
    title: 'Book a discovery call',
    body: 'Tell us what you need, a team in Nigeria, a document, or research on a market.',
  },
  {
    title: 'We scope it',
    body: 'You get exactly what we’ll do and what it costs, no long contracts.',
  },
  {
    title: 'We get to work',
    body: 'Recruiting, writing, or researching, whichever applies to you.',
  },
  {
    title: 'You stay updated',
    body: 'Weekly check-ins if it’s HR, regular updates either way, so you’re never wondering what’s happening.',
  },
];

const faqs = [
  {
    q: 'Do you only work with businesses abroad?',
    a: 'No. We work with businesses in Nigeria and across the diaspora, anyone who needs a team managed, a document written, or research done.',
  },
  {
    q: 'How fast can you start?',
    a: 'Once we’ve scoped what you need on a discovery call, we can usually begin immediately, with full focus on getting it right.',
  },
  {
    q: 'How do payments work?',
    a: 'We handle payroll for your team directly, so you’re not managing bank transfers or compliance yourself.',
  },
  {
    q: 'What if it’s not a fit?',
    a: 'There are no long contracts. If it’s not working, you can walk away.',
  },
];
---
<BaseLayout
  title="Masy Consulting — Fractional HR, Business Writing & Market Intelligence for African Businesses"
  description="Masy Consulting gives African-founded and diaspora-owned businesses the writing, people operations, and market intelligence of a world-class consultancy, grounded in how African businesses actually operate."
  footerMarker={{ idx: '07', label: 'Contact', count: '07 / 07' }}
>
  <!-- ============ HERO (locked) ============ -->
  <HeroSlides />

  <!-- ============ 01 · THE PROBLEM ============ -->
  <section class="bg-paper">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="01" label="The problem, plainly" count="01 / 07" />

      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-start">
        <div data-reveal>
          <h2 class="font-display font-extrabold text-[clamp(2rem,3.6vw,2.9rem)] leading-[1.12] tracking-[-0.025em] text-ink mb-5">
            Scaling across borders creates three
            <span class="whitespace-nowrap"><span class="sig">very specific problems<svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c50-7 220-7 296 4"/></svg></span>.</span>
          </h2>
          <p class="text-[16.5px] text-slate leading-relaxed max-w-[440px] text-pretty">
            They usually get patched by a cousin who writes well, a friend who
            "does HR," and a few late nights on Google. That works, until the
            business gets serious.
          </p>
        </div>

        <div class="flex flex-col" data-reveal-stagger>
          {problems.map((p) => (
            <article class="py-7 first:pt-1 border-t border-ink/10">
              <div class="flex items-start gap-5">
                <span class="font-mono font-semibold text-[40px] leading-none tracking-[-0.01em] text-indigo/15 flex-none w-14 select-none" aria-hidden="true">{p.num}</span>
                <div>
                  <h3 class="font-display font-extrabold text-[1.22rem] tracking-[-0.02em] text-ink mb-2">{p.title}</h3>
                  <p class="text-[14.5px] text-slate leading-relaxed max-w-[420px] text-pretty">{p.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 02 · PILLARS ============ -->
  <section id="pillars" class="bg-white scroll-mt-24">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="02" label="What we do" count="02 / 07" />

      <div class="max-w-[640px] mb-9" data-reveal>
        <h2 class="font-display font-extrabold text-[clamp(2rem,3.8vw,3rem)] leading-[1.08] tracking-[-0.03em] text-ink text-balance">
          Three pillars. One partner. Zero hand-offs between vendors.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-[22px]" data-reveal-stagger>
        {pillarCards.map((c) => (
          <a
            href={c.href}
            class="relative bg-white border border-[#E7E4DC] rounded-xl px-7 pt-8 pb-7 flex flex-col gap-3.5 overflow-hidden transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:border-transparent hover:shadow-[0_28px_50px_-32px_rgba(20,10,69,0.28)]"
          >
            <span class="absolute top-0 left-0 right-0 h-[3px]" style={`background:${c.accent}`} aria-hidden="true"></span>
            <div class="flex items-center justify-between">
              <span class="font-mono font-semibold text-[12.5px] text-slate/50">{c.idx}</span>
              <div class="w-10 h-10 rounded-[9px] bg-[#EEEAFB] flex items-center justify-center" style={`color:${c.accent}`} set:html={c.icon} />
            </div>
            <h3 class="font-display font-extrabold text-[1.28rem] tracking-[-0.02em] text-ink mt-1">{c.title}</h3>
            <p class="text-[14.5px] text-slate leading-relaxed flex-1 text-pretty">{c.body}</p>
            <span class="self-start font-mono font-semibold text-[10.5px] uppercase tracking-[0.05em] text-slate/60 border border-[#E7E4DC] rounded-full px-[11px] py-[5px] mt-0.5">{c.tag}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 03 · WHO THIS IS FOR ============ -->
  <section class="texture-dots">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="03" label="Who this is for" count="03 / 07" />

      <div class="max-w-[640px] mb-9" data-reveal>
        <h2 class="font-display font-extrabold text-[clamp(2rem,3.8vw,3rem)] leading-[1.08] tracking-[-0.03em] text-ink">
          If any of this sounds
          <span class="whitespace-nowrap"><span class="sig">familiar<svg viewBox="0 0 140 16" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c22-7 96-7 136 4"/></svg></span>.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5" data-reveal-stagger>
        {whoFeatured.map((w) => (
          <div class="bg-white border border-[#E7E4DC] rounded-xl px-8 py-[34px] flex flex-col gap-3.5 transition-all duration-300 ease-out-expo hover:-translate-y-[3px] hover:border-indigo-light hover:shadow-[0_24px_48px_-30px_rgba(40,19,152,0.32)]">
            <span class="font-mono font-semibold text-[12.5px] text-slate/50">{w.idx}</span>
            <h3 class="font-display font-extrabold text-[1.3rem] tracking-[-0.02em] text-ink">{w.title}</h3>
            <p class="text-[15px] text-slate leading-relaxed text-pretty">{w.body}</p>
          </div>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 gap-5 mt-5" data-reveal-stagger>
        <div class="bg-white border border-[#E7E4DC] rounded-xl px-6 py-[26px] flex flex-col gap-2.5">
          <span class="font-mono font-semibold text-[12.5px] text-slate/50">03</span>
          <h3 class="font-display font-extrabold text-[1.05rem] tracking-[-0.02em] text-ink">Need outsourced HR</h3>
          <p class="text-[13.5px] text-slate leading-relaxed text-pretty">
            You already have a team, but no HR department, and hiring one just
            to manage payroll, performance, and day-to-day people issues
            doesn't make sense yet. You'd rather hand it to someone who
            already knows how.
          </p>
        </div>

        <div class="bg-indigo rounded-xl px-6 py-[26px] flex flex-col gap-2.5 relative overflow-hidden">
          <span class="font-mono font-semibold text-[12.5px] text-white/40">04</span>
          <span class="font-mono font-semibold text-[11px] uppercase tracking-[0.06em] text-[#FFC876]">Everyone else</span>
          <h3 class="font-display font-extrabold text-[1.05rem] tracking-[-0.02em] text-white">A few more we hear often</h3>
          <p class="who-slide-text text-[13.5px] text-[#C6BEEF] leading-relaxed min-h-[56px]" id="whoSlideText">
            Raising capital and need real market data behind the pitch.
          </p>
          <div class="flex gap-1.5 mt-auto pt-2" id="whoSlideDots"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 04 · HOW IT WORKS ============ -->
  <section id="how" class="bg-indigo text-white scroll-mt-24">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="04" label="How it works" count="04 / 07" tone="dark" />

      <div class="max-w-[640px] mb-9" data-reveal>
        <h2 class="font-display font-extrabold text-[clamp(2rem,3.8vw,3rem)] leading-[1.08] tracking-[-0.03em] text-white">
          Four steps, start to finish.
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-[22px]" data-reveal-stagger>
        {steps.map((step, i) => (
          <div class="relative pt-[22px] px-1 border-t-[1.5px] border-white/[0.18]">
            <span class="font-mono font-bold text-[80px] leading-none text-white/[0.08] absolute -top-2 right-0 select-none" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display font-extrabold text-[1.08rem] tracking-[-0.02em] text-white mt-2.5 mb-2 relative">{step.title}</h3>
            <p class="text-[13.5px] text-[#C6BEEF] leading-relaxed relative text-pretty">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 05 · FAQ ============ -->
  <section class="bg-white">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="05" label="FAQ" count="05 / 07" />

      <div class="max-w-[640px] mx-auto text-center mb-9" data-reveal>
        <h2 class="font-display font-extrabold text-[clamp(2rem,3.8vw,3rem)] leading-[1.08] tracking-[-0.03em] text-ink text-balance">
          Questions people ask before booking a call.
        </h2>
      </div>

      <div class="max-w-[760px] mx-auto border-t border-[#E7E4DC]" data-reveal>
        {faqs.map((f) => (
          <details class="faq-item border-b border-[#E7E4DC]">
            <summary class="flex items-center justify-between gap-5 py-6 px-1 cursor-pointer font-semibold text-[17px] tracking-[-0.01em] text-ink">
              {f.q}
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <p class="px-1 pb-6 text-[15px] text-slate leading-relaxed max-w-[640px]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 06 · GET STARTED ============ -->
  <section id="contact" class="bg-white scroll-mt-24">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-14 sm:py-[88px]">
      <Marker idx="06" label="Get started" count="06 / 07" />

      <div class="cta-band bg-ink rounded-[20px] px-6 py-11 sm:px-[52px] sm:py-16 relative overflow-hidden" data-reveal>
        <div class="max-w-[600px] mx-auto text-center relative z-[1]">
          <h2 class="font-display font-extrabold text-[clamp(1.9rem,3.8vw,2.8rem)] leading-[1.1] tracking-[-0.03em] text-white mb-4">
            Let's take this off your plate.
          </h2>
          <p class="text-[15.5px] text-[#B9B4C9] leading-[1.65] mb-8">
            Book a discovery call, or message us on WhatsApp, whichever's easier.
          </p>
          <div class="flex flex-wrap justify-center items-center gap-4">
            <Button href="/contact/" variant="primary">Book a discovery call</Button>
            <Button href="/contact/" variant="outlineDark">WhatsApp us</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hand-drawn underline; the stroke draws itself when the reveal
     engine marks the block in view. */
  .sig {
    position: relative;
    display: inline-block;
    color: theme('colors.indigo.DEFAULT');
  }
  .sig svg {
    position: absolute;
    left: -2%;
    bottom: -6px;
    width: 104%;
    height: 16px;
    overflow: visible;
  }
  .sig path {
    stroke: theme('colors.orange.DEFAULT');
    stroke-width: 3.5;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
  }
  .is-inview .sig path {
    animation: sig-draw 1s var(--ease-out-expo) 0.3s forwards;
  }
  @keyframes sig-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sig path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  /* Dotted-paper texture behind "Who this is for" */
  .texture-dots {
    background-color: theme('colors.paper');
    background-image: radial-gradient(#e7e4dc 1.2px, transparent 1.2px);
    background-size: 22px 22px;
  }

  /* Rotating "everyone else" card */
  .who-slide-text {
    transition: opacity 0.4s var(--ease-out-expo);
  }
  #whoSlideDots :global(span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    transition: background 0.3s;
  }
  #whoSlideDots :global(span.active) {
    background: theme('colors.orange.DEFAULT');
  }

  /* FAQ accordion */
  .faq-item summary {
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item .plus {
    flex: none;
    width: 22px;
    height: 22px;
    position: relative;
  }
  .faq-item .plus::before,
  .faq-item .plus::after {
    content: '';
    position: absolute;
    background: theme('colors.indigo.DEFAULT');
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }
  .faq-item .plus::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-item .plus::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq-item[open] .plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }

  /* Orange glow in the CTA band */
  .cta-band::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -60px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(251, 150, 31, 0.16) 0%, transparent 70%);
  }
</style>

<script>
  // Rotating quotes in the "Everyone else" card
  const whoSlides = [
    'Raising capital and need real market data behind the pitch.',
    'Entering a new state or country and need to understand it first.',
    "Already tried an in-house HR hire and it didn't stick.",
    'Need documents that hold up in front of investors or partners.',
  ];
  const whoText = document.getElementById('whoSlideText');
  const whoDots = document.getElementById('whoSlideDots');
  if (whoText && whoDots && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    whoSlides.forEach((_, i) => {
      const dot = document.createElement('span');
      if (i === 0) dot.classList.add('active');
      whoDots.appendChild(dot);
    });
    let whoIndex = 0;
    setInterval(() => {
      whoIndex = (whoIndex + 1) % whoSlides.length;
      whoText.style.opacity = '0';
      setTimeout(() => {
        whoText.textContent = whoSlides[whoIndex];
        whoText.style.opacity = '1';
        [...whoDots.children].forEach((d, i) => d.classList.toggle('active', i === whoIndex));
      }, 400);
    }, 3200);
  }
</script>
