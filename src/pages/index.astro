---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HeroSlides from '../components/HeroSlides.astro';
import Marquee from '../components/Marquee.astro';
import PillarIndex from '../components/PillarIndex.astro';
import CTASection from '../components/CTASection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const problems = [
  {
    num: '01',
    title: 'Deals die on paper',
    body: 'The work is excellent. The proposal describing it isn’t. Somewhere between your ability and your documents, the contract goes quiet.',
  },
  {
    num: '02',
    title: 'A team you can’t see',
    body: 'Your staff are in Lagos. You’re in London. Policy lives in someone’s head, and problems surface as 11pm phone calls instead of Tuesday check-ins.',
  },
  {
    num: '03',
    title: 'Decisions made on instinct',
    body: 'You’re entering a market or backing a call on gut feel, because the research that should inform it was priced for multinationals, not for you.',
  },
];

const steps = [
  {
    title: 'A real conversation',
    body: 'Thirty minutes on your business and the gap you’re trying to close. No script, no deck, no pressure.',
  },
  {
    title: 'A scoped plan',
    body: 'What we’ll do, how long it takes, what it costs. In writing, before anything is signed.',
  },
  {
    title: 'Work you can see',
    body: 'Drafts, policies, or findings on the cadence you agreed to. Never a black box.',
  },
  {
    title: 'A standing partner',
    body: 'HR runs as a retainer. Writing and research come back to a partner who already knows your business.',
  },
];
---
<BaseLayout
  title="Masy Consulting — Fractional HR, Business Writing & Market Intelligence for African Businesses"
  description="Masy Consulting gives African-founded and diaspora-owned businesses the writing, people operations, and market intelligence of a world-class consultancy, grounded in how African businesses actually operate."
>
  <!-- ============ HERO ============ -->
  <HeroSlides />

  <!-- ============ MARQUEE ============ -->
  <Marquee />

  <!-- ============ THE PROBLEM ============ -->
  <section class="bg-paper">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-24">
      <div class="flex items-baseline justify-between gap-4 pb-5 mb-12 border-b border-ink/10" data-reveal>
        <span class="flex items-baseline gap-2.5 text-[13px] font-semibold uppercase tracking-[0.05em] text-orange-deep">
          <span class="font-mono font-semibold text-slate/50">01</span>
          The problem, plainly
        </span>
        <span class="font-mono text-[12px] tracking-[0.05em] text-slate/50">01 / 06</span>
      </div>

      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-start">
        <div data-reveal>
          <h2 class="font-display font-extrabold text-[clamp(2rem,3.6vw,2.9rem)] leading-[1.12] tracking-[-0.025em] text-ink mb-5">
            Scaling across borders creates three
            <span class="whitespace-nowrap"><span class="sig">very specific problems<svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c50-7 220-7 296 4"/></svg></span>.</span>
          </h2>
          <p class="text-[16.5px] text-slate leading-relaxed max-w-[440px] text-pretty">
            They usually get patched by a cousin who writes well, a friend who
            "does HR," and a few late nights on Google. That works, until the
            business gets serious.
          </p>
        </div>

        <div class="flex flex-col" data-reveal-stagger>
          {problems.map((p) => (
            <article class="py-7 first:pt-1 border-t border-ink/10">
              <div class="flex items-start gap-[22px]">
                <span class="font-mono font-semibold text-[40px] leading-none tracking-[-0.01em] text-indigo/15 flex-none w-14 select-none" aria-hidden="true">{p.num}</span>
                <div>
                  <h3 class="font-display font-extrabold text-[1.28rem] tracking-[-0.02em] text-ink mb-2">{p.title}</h3>
                  <p class="text-[14.5px] text-slate leading-relaxed max-w-[420px] text-pretty">{p.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PILLARS INDEX ============ -->
  <section id="pillars" class="bg-paper scroll-mt-24">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-24 sm:py-32">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-14" data-reveal>
        <div>
          <Eyebrow num="02">What we do</Eyebrow>
          <h2 class="mt-6 font-display font-bold text-[clamp(2rem,4.2vw,3.1rem)] leading-[1.06] tracking-[-0.02em] text-ink max-w-2xl text-balance">
            Three pillars. One partner. Zero hand-offs between vendors.
          </h2>
        </div>
        <p class="text-[15px] text-slate max-w-xs leading-relaxed lg:text-right lg:pb-2">
          Your people, your paperwork, and your market knowledge, each handled
          by someone who understands the other two.
        </p>
      </div>

      <PillarIndex />
    </div>
  </section>

  <!-- ============ POSITIONING (DARK) ============ -->
  <section class="relative bg-ink text-white overflow-hidden dark-section">
    <div class="absolute inset-0 grain-overlay"></div>
    <div
      class="absolute left-1/2 top-0 -translate-x-1/2 w-[900px] h-[500px] opacity-[0.07] pointer-events-none"
      style="background: radial-gradient(ellipse at top, #2F32D5 0%, transparent 65%)"
    ></div>

    <div class="max-w-content mx-auto px-5 sm:px-8 py-24 sm:py-36 relative">
      <div class="max-w-4xl" data-reveal>
        <Eyebrow light num="03">Why Masy exists</Eyebrow>
        <p class="mt-8 font-display text-[clamp(1.9rem,4.6vw,3.6rem)] leading-[1.12] tracking-[-0.015em] text-balance">
          The credible firms are built for multinationals. The affordable ones
          are built for volume.
          <span class="text-orange">Nobody was built for you.</span>
        </p>
        <p class="mt-8 text-white/65 text-[16.5px] leading-relaxed max-w-2xl text-pretty">
          Masy Consulting is the professional services partner for the business
          owner who needs their documents, their people, and their market
          intelligence handled with the same rigor as their business idea. Not
          generic frameworks borrowed from elsewhere. Real operational
          understanding of African markets.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/10 border border-white/10 rounded-2xl overflow-hidden" data-reveal-stagger>
        {[
          ['3', 'connected capabilities under one roof'],
          ['1', 'partner instead of three unconnected vendors'],
          ['4', 'countries served: UK, US, Canada, Nigeria'],
          ['0', 'academic writing. That’s Masy Academy, not us'],
        ].map(([value, label]) => (
          <div class="bg-ink p-7 sm:p-8">
            <p class="font-display text-[clamp(2rem,4vw,3rem)] text-orange leading-none">{value}</p>
            <p class="mt-3 text-[13px] text-white/55 leading-snug">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="bg-paper">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-24 sm:py-32">
      <div class="lg:pl-[16%]" data-reveal>
        <Eyebrow num="04">How an engagement starts</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(2rem,4.2vw,3.1rem)] leading-[1.06] tracking-[-0.02em] text-ink max-w-xl text-balance">
          No black box. No jargon. A process you can follow.
        </h2>
      </div>

      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 lg:gap-y-0" data-reveal-stagger>
        {steps.map((step, i) => (
          <div class="relative pt-8 border-t-2 border-ink/12">
            <span class="absolute -top-[7px] left-0 w-3 h-3 rounded-full bg-orange"></span>
            <span class="font-mono text-[12px] text-orange-deep">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display font-bold text-[20px] text-ink leading-snug">{step.title}</h3>
            <p class="mt-2.5 text-[14px] text-slate leading-relaxed text-pretty">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ INSIGHTS TEASER ============ -->
  <section class="bg-white">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-24 sm:py-32">
      <div class="flex items-end justify-between gap-6 mb-12" data-reveal>
        <div>
          <Eyebrow num="05">Insights</Eyebrow>
          <h2 class="mt-6 font-display font-bold text-[clamp(1.9rem,3.8vw,2.8rem)] leading-[1.08] tracking-[-0.02em] text-ink text-balance">
            Things worth knowing, whether you hire us or not.
          </h2>
        </div>
        <a href="/insights/" class="link-underline hidden sm:inline-flex items-center gap-2 text-[15px] font-medium text-ink whitespace-nowrap pb-1">
          All insights
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L8.8 3.8M13 8L8.8 12.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="border-t border-ink/10" data-reveal-stagger>
        {posts.map((post) => (
          <a
            href={`/insights/${post.slug}/`}
            class="group grid sm:grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-8 gap-y-2 py-7 border-b border-ink/10"
          >
            <div class="min-w-0">
              <p class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-orange-deep mb-2.5">
                {post.data.pillar} · {post.data.readMinutes} min
              </p>
              <h3 class="font-display font-bold text-[clamp(1.25rem,2.6vw,1.75rem)] leading-[1.2] text-ink group-hover:text-indigo transition-colors duration-300 text-balance">
                {post.data.title}
              </h3>
            </div>
            <span class="hidden sm:inline-flex items-center gap-2 text-[13.5px] font-medium text-slate group-hover:text-ink transition-colors">
              Read
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M13 8L8.8 3.8M13 8L8.8 12.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <CTASection
    heading="Tell us what's slowing your business down."
    body="Thirty minutes, no obligation. We'll tell you exactly how we'd fix it, and if we're not the right people, we'll say so and point you somewhere better."
    primaryLabel="Book a consultation"
    secondaryLabel="Read our thinking"
    secondaryHref="/insights/"
  />
</BaseLayout>

<style>
  /* Hand-drawn underline on the problem headline; the stroke draws
     itself when the reveal engine marks the column in view. */
  .sig {
    position: relative;
    display: inline-block;
    color: theme('colors.indigo.DEFAULT');
  }
  .sig svg {
    position: absolute;
    left: -2%;
    bottom: -6px;
    width: 104%;
    height: 16px;
    overflow: visible;
  }
  .sig path {
    stroke: theme('colors.orange.DEFAULT');
    stroke-width: 3.5;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
  }
  .is-inview .sig path {
    animation: sig-draw 1s var(--ease-out-expo) 0.3s forwards;
  }
  @keyframes sig-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sig path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
