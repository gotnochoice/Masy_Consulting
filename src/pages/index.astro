---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import WorldClock from '../components/WorldClock.astro';
import PillarCard from '../components/PillarCard.astro';
import Stat from '../components/Stat.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTASection from '../components/CTASection.astro';
import Logomark from '../components/Logomark.astro';

const painPoints = [
  {
    title: 'Documents that undersell you',
    body: 'The proposal goes out. The deal goes quiet. Not because the work isn’t good, because the paper never said so.',
  },
  {
    title: 'A team you can’t see',
    body: 'Payroll gets confusing. Policies live in someone’s head. A problem in Lagos becomes a 2am phone call in London.',
  },
  {
    title: 'Decisions made on instinct',
    body: 'You’re entering a market or backing a call with a gut feeling, because the research that should inform it doesn’t exist yet.',
  },
];

const processSteps = [
  {
    title: 'A real conversation',
    body: 'Thirty minutes on your business, your team, and the gap you’re trying to close. No script, no pitch deck.',
  },
  {
    title: 'A scoped plan',
    body: 'You get a clear brief of what we’ll do, how long it takes, and what it costs, before anything is signed.',
  },
  {
    title: 'Work you can see',
    body: 'Drafts, policies, or research delivered on a cadence you agreed to, not disappeared into a black box.',
  },
  {
    title: 'A standing relationship',
    body: 'For HR, an ongoing retainer. For writing and research, a partner who already knows your business next time.',
  },
];
---
<BaseLayout
  title="Masy Consulting — Fractional HR, Business Writing & Market Intelligence for African Businesses"
  description="Masy Consulting gives African-founded and diaspora-owned businesses the writing, people operations, and market intelligence of a world-class consultancy, grounded in how African businesses actually operate."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-white">
    <div
      class="absolute -left-32 -top-40 w-[560px] h-[560px] rounded-full opacity-[0.05] pointer-events-none"
      style="background: radial-gradient(circle, #FB961F 0%, transparent 70%)"
    ></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 pt-14 sm:pt-20 pb-16 sm:pb-24 relative">
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-14 lg:gap-10 items-start">
        <div>
          <Eyebrow>For diaspora founders &amp; African business owners</Eyebrow>
          <h1 class="mt-6 font-display font-medium text-[clamp(2.5rem,6vw,4.25rem)] leading-[1.04] tracking-tight text-indigo-deep text-balance">
            Run your African team like you’re in the room.
            <span class="italic font-normal text-indigo">From wherever you are.</span>
          </h1>
          <p class="mt-7 text-[17px] sm:text-[18.5px] text-slate leading-relaxed max-w-xl text-pretty">
            Masy Consulting manages the people who run your business, writes the documents that
            win your deals, and researches the markets you’re about to enter. One partner, built
            on real understanding of how African businesses actually operate.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <Button href="/contact/" variant="primary" size="lg">Book a consultation</Button>
            <Button href="#pillars" variant="ghost" size="lg">See how it works</Button>
          </div>
          <div class="mt-12 flex items-center gap-6 text-slate/70">
            <Logomark class="w-8 h-8 opacity-70" />
            <p class="text-[13.5px] leading-snug max-w-sm">
              Most consultants theorise about African markets.
              <span class="text-indigo-deep font-medium">Masy delivers.</span>
            </p>
          </div>
        </div>

        <div class="lg:pt-2">
          <WorldClock />
          <p class="mt-4 text-[13px] text-slate/70 leading-relaxed px-1">
            Lagos and London run close to the same clock. Your team keeps your hours, not the other side of the world.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="bg-sand border-y border-indigo-deep/5">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-16 sm:py-20">
      <div class="max-w-xl">
        <Eyebrow>The problem, plainly</Eyebrow>
        <h2 class="mt-5 font-display text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.15] text-indigo-deep text-balance">
          Growth across borders creates three specific problems.
        </h2>
      </div>
      <div class="mt-12 grid sm:grid-cols-3 gap-px bg-indigo-deep/10 rounded-2xl overflow-hidden">
        {painPoints.map((p) => (
          <div class="bg-white p-7 sm:p-8">
            <h3 class="font-display text-[19px] text-indigo-deep leading-snug">{p.title}</h3>
            <p class="mt-3 text-[14.5px] text-slate leading-relaxed text-pretty">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section id="pillars" class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28 scroll-mt-20">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div class="max-w-xl">
        <Eyebrow>One partner, three rooms</Eyebrow>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4vw,2.75rem)] leading-[1.12] text-indigo-deep text-balance">
          Not a menu of services. One system for running a serious business across two continents.
        </h2>
      </div>
      <p class="text-[14.5px] text-slate max-w-sm leading-relaxed">
        Each pillar stands on its own. Together, they mean your people, your paperwork, and your
        market knowledge are handled by a partner who already understands the other two.
      </p>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-5">
      <PillarCard
        number="01"
        name="Fractional HR & People Management"
        short="You run the business from the UK or US. We manage your African team, so you don’t have to."
        href="/fractional-hr/"
        anchor
        points={[
          'Staff management and day-to-day people operations',
          'HR policy, contracts, handbooks and onboarding',
          'Recruitment and placement for growing SMEs',
        ]}
      />
      <PillarCard
        number="02"
        name="Business Writing"
        short="The documents that open doors, written with the rigor your business already operates with."
        href="/business-writing/"
        points={[
          'Business proposals and grant applications',
          'Pitch decks and investor documents',
          'Company profiles and executive reports',
        ]}
      />
      <PillarCard
        number="03"
        name="Industry Analysis & Market Surveys"
        short="The research behind your next market entry, expansion, or investment decision."
        href="/industry-analysis/"
        points={[
          'Market entry and expansion research',
          'Industry reports for investment decisions',
          'Custom surveys for a new market or segment',
        ]}
      />
    </div>
  </section>

  <!-- POSITIONING -->
  <section class="bg-indigo-deep text-white relative overflow-hidden">
    <div class="absolute inset-0 grain-overlay"></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28 relative">
      <div class="grid lg:grid-cols-[1fr_0.9fr] gap-14 items-center">
        <div>
          <Eyebrow light>Why Masy exists</Eyebrow>
          <p class="mt-6 font-display text-[clamp(1.9rem,4vw,2.85rem)] leading-[1.2] text-balance">
            Generic frameworks weren’t built for how African businesses actually operate.
            <span class="text-orange">Masy was.</span>
          </p>
          <p class="mt-6 text-white/70 text-[16px] leading-relaxed max-w-lg text-pretty">
            For the business owner who needs their documents, their people, and their market
            intelligence handled with the same rigor as their business idea, Masy Consulting is
            the professional services partner built on real operational understanding of African
            markets, not theory borrowed from elsewhere.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-8 gap-y-10">
          <Stat value="3" label="Capabilities under one partner instead of three vendors" class="[&_p:first-child]:!text-orange" />
          <Stat value="1" label="Point of contact for your team, your paper, and your data" class="[&_p:first-child]:!text-orange" />
          <Stat value="UK · US" label="Canada &amp; Nigeria, one working relationship across all four" class="[&_p:first-child]:!text-orange" />
          <Stat value="0" label="Academic writing or tutoring. That’s Masy Academy, not us" class="[&_p:first-child]:!text-orange" />
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div class="max-w-xl">
      <Eyebrow>How an engagement actually starts</Eyebrow>
      <h2 class="mt-5 font-display text-[clamp(1.9rem,4vw,2.75rem)] leading-[1.12] text-indigo-deep text-balance">
        No black box. No jargon. A process you can actually follow.
      </h2>
    </div>
    <div class="mt-12">
      <ProcessSteps steps={processSteps} />
    </div>
  </section>

  <CTASection
    heading="Tell us what’s slowing your business down. We’ll tell you exactly how we’d fix it."
    body="Thirty minutes, no obligation. If we’re not the right fit, we’ll say so and point you somewhere better."
    primaryLabel="Book a consultation"
    secondaryLabel="Read our thinking"
    secondaryHref="/insights/"
  />
</BaseLayout>
