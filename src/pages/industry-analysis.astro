---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarHero from '../components/PillarHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PricingNote from '../components/PricingNote.astro';
import CTASection from '../components/CTASection.astro';

const included = [
  {
    title: 'Desk research & analysis',
    body: 'Industry overviews, market sizing, and competitive landscapes, built from existing data and sharpened into something you can actually act on.',
  },
  {
    title: 'Primary & field research',
    body: 'Our own team conducts the interviews, in-person surveys, and data collection, in Nigeria or other African markets, for when you need original data.',
  },
  {
    title: 'Written reports',
    body: 'Findings written up as a report you can hand straight to investors or partners, by the same team, no separate vendor required.',
  },
];

const whoFor = [
  {
    title: 'Raising a round',
    body: 'You need market sizing or a competitive landscape to back up the numbers in your pitch deck, not just assumptions.',
  },
  {
    title: 'Entering a new market',
    body: 'You’re expanding into Africa, or into a new African market, and need real data before you commit resources.',
  },
  {
    title: 'Only have desk data',
    body: 'You’ve got reports and secondary sources, but nobody has actually gone out and verified any of it on the ground.',
  },
  {
    title: 'Tried buying reports off the shelf',
    body: 'Generic industry reports didn’t answer the specific question you actually needed answered.',
  },
];

const faqs = [
  {
    q: 'What’s the difference between desk research and primary research?',
    a: 'Desk research works from data that already exists: reports, public sources, existing surveys. Primary research means our own team goes out and collects new data through interviews or surveys. We’ll help you figure out which one actually answers your question on the discovery call.',
  },
  {
    q: 'Do you only cover Nigeria?',
    a: 'No. Nigeria is where our fieldwork team is based, but we cover other African markets too, scoped on the discovery call depending on what you need.',
  },
  {
    q: 'Can this be delivered as something we can hand to investors?',
    a: 'Yes. Findings are written up as a proper report by the same team that ran the research, not handed off to a separate writer who has to be re-briefed from scratch.',
  },
];

const steps = [
  { title: 'Define the question', body: 'A market study is only as useful as the question it answers, so that’s where every project starts, in writing.' },
  { title: 'Fieldwork & sourcing', body: 'Primary interviews, on-the-ground sourcing, and desk research, combined honestly instead of padded with filler.' },
  { title: 'Analysis', body: 'We separate what the data actually shows from what would be convenient for it to show.' },
  { title: 'Report & briefing', body: 'A written report plus a live walkthrough, so you can push back, ask questions, and stress-test the findings.' },
];
---
<BaseLayout
  title="Industry Analysis & Market Surveys for African Markets"
  description="Masy Consulting delivers market entry research, industry reports, and custom surveys for businesses making a real decision about an African market, sized and priced for SMEs, not multinationals."
>
  <PillarHero
    number="03"
    label="Industry Analysis & Market Surveys"
    title="Research built for the decision"
    titleAccent="you're actually making."
    lead="You're entering a market, backing a call, or answering to an investor who wants evidence, not confidence. Masy delivers the market entry research, industry reports, and custom surveys that inform a real decision, grounded in how the market actually behaves."
    facts={[
      ['Engagement', 'Per project'],
      ['Scope', 'Agreed before fieldwork'],
      ['Methods', 'Primary + desk research'],
      ['Delivery', 'Report + live briefing'],
      ['Sized for', 'SMEs & investors'],
    ]}
  />

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div data-reveal>
      <Eyebrow num="01">What this covers</Eyebrow>
      <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
        Answers you can put in front of an investor, lender, or your own board.
      </h2>
    </div>
    <div class="mt-12">
      <ServiceGrid items={included} />
    </div>
  </section>

  <section class="relative bg-ink text-white overflow-hidden dark-section">
    <div class="absolute inset-0 grain-overlay"></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28 relative">
      <div class="max-w-3xl" data-reveal>
        <Eyebrow light num="02">The gap between two extremes</Eyebrow>
        <p class="mt-7 font-display text-[clamp(1.7rem,3.8vw,2.9rem)] leading-[1.15] tracking-[-0.015em] text-balance">
          Institutional research is priced for multinationals. Macro reports never answer your question.
          <span class="text-orange">Masy sits in between.</span>
        </p>
        <p class="mt-7 text-white/65 text-[16px] leading-relaxed max-w-2xl text-pretty">
          Rigorous enough to support a real decision. Sized and priced for a
          business that isn't a multinational. Written by people who understand
          the specific market you're asking about, not the continent in
          general.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div data-reveal>
      <Eyebrow num="03">Who this is for</Eyebrow>
      <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
        If any of this sounds familiar.
      </h2>
    </div>
    <div class="mt-12 grid sm:grid-cols-2 gap-5" data-reveal-stagger>
      {whoFor.map((item, i) => (
        <div class="rounded-[1.5rem] bg-white border border-ink/12 p-7 sm:p-8 flex flex-col gap-2.5">
          <span class="font-mono text-[12.5px] font-semibold text-slate/50">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-display font-bold text-[1.15rem] text-ink">{item.title}</h3>
          <p class="text-[14px] text-slate leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white border-y border-ink/10">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
      <div data-reveal>
        <Eyebrow num="04">How it works</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          From a vague hunch to a report that holds up.
        </h2>
      </div>
      <div class="mt-14">
        <ProcessSteps steps={steps} />
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <PricingNote
      model="Industry analysis is scoped and priced per project, based on the market, the question, and how much primary fieldwork is required."
      points={[
        'Scope and price agreed before fieldwork starts',
        'Desk and primary research priced separately when useful',
        'Custom surveys sized to your budget and question',
        'Ongoing market-tracking retainers available',
      ]}
    />
  </section>

  <section class="bg-paper">
    <div class="max-w-content mx-auto px-5 sm:px-8 py-20 sm:py-28">
      <div data-reveal>
        <Eyebrow num="05">FAQ</Eyebrow>
        <h2 class="mt-6 font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          Questions people ask before booking a call.
        </h2>
      </div>
      <div class="mt-12 max-w-[760px] border-t border-ink/10" data-reveal>
        {faqs.map((f) => (
          <details class="faq-item border-b border-ink/10">
            <summary class="flex items-center justify-between gap-5 py-6 px-1 cursor-pointer font-semibold text-[17px] tracking-[-0.01em] text-ink">
              {f.q}
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <p class="px-1 pb-6 text-[15px] text-slate leading-relaxed max-w-[640px]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Back your next decision with real data."
    body="Book a discovery call, or message us on WhatsApp, whichever's easier."
    primaryLabel="Book a discovery call"
    secondaryLabel="WhatsApp us"
    secondaryHref="/contact/"
  />
</BaseLayout>

<style>
  .faq-item summary {
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item .plus {
    flex: none;
    width: 22px;
    height: 22px;
    position: relative;
  }
  .faq-item .plus::before,
  .faq-item .plus::after {
    content: '';
    position: absolute;
    background: theme('colors.indigo.DEFAULT');
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out-expo), opacity 0.25s;
  }
  .faq-item .plus::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-item .plus::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq-item[open] .plus::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
</style>
