---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marker from '../components/Marker.astro';
import IconCardGrid from '../components/IconCardGrid.astro';
import PersonaGrid from '../components/PersonaGrid.astro';
import ProcessCards from '../components/ProcessCards.astro';
import FaqCards from '../components/FaqCards.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';

const facts = [
  { label: 'Two levels', body: 'Desk research and analysis, or primary fieldwork when you need original data, not just a synthesis of what’s already out there.' },
  { label: 'On the ground', body: 'Interviews, surveys, and data collection conducted in Nigeria and other African markets, not outsourced to a call centre.' },
  { label: 'One team', body: 'The same team that runs the research can write up the report, no re-briefing a second vendor.' },
  { label: 'Pricing', body: 'Scoped and priced per project, agreed before fieldwork starts, not a generic rate card.' },
];

const included = [
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 19V5a1 1 0 0 1 1-1h9l6 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.8"/><path d="M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
    badge: 'Level 1',
    title: 'Desk research & analysis',
    body: 'Industry overviews, market sizing, and competitive landscapes, built from existing data and sharpened into something you can actually act on.',
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 20l-5-2V6l5 2m0 12l6-2m-6 2V8m6 10l5 2V6l-5-2m0 16V6m0 0L9 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    badge: 'Level 2',
    title: 'Primary & field research',
    body: 'Our own team conducts the interviews, in-person surveys, and data collection, in Nigeria or other African markets, for when you need original data.',
  },
  {
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8"/><path d="M14 2v6h6M9 15l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    badge: 'Delivery',
    title: 'Written reports',
    body: 'Findings written up as a report you can hand straight to investors or partners, by the same team, no separate vendor required.',
  },
];

const whoFor = [
  {
    title: 'Raising a round',
    body: 'You need market sizing or a competitive landscape to back up the numbers in your pitch deck, not just assumptions.',
  },
  {
    title: 'Entering a new market',
    body: 'You’re expanding into Africa, or into a new African market, and need real data before you commit resources.',
  },
  {
    title: 'Only have desk data',
    body: 'You’ve got reports and secondary sources, but nobody has actually gone out and verified any of it on the ground.',
  },
  {
    title: 'Tried buying reports off the shelf',
    body: 'Generic industry reports didn’t answer the specific question you actually needed answered.',
  },
];

const steps = [
  { title: 'Book a discovery call', body: 'Tell us what decision this research needs to support.' },
  { title: 'We scope it', body: 'Desk research, primary fieldwork, or both, decided upfront, with a fixed cost.' },
  { title: 'We do the work', body: 'Our team runs the research, on the ground where it’s needed.' },
  { title: 'You get the findings', body: 'Delivered as a written report, ready to hand to investors or partners.' },
];

const faqs = [
  {
    q: 'What’s the difference between desk research and primary research?',
    a: 'Desk research works from data that already exists: reports, public sources, existing surveys. Primary research means our own team goes out and collects new data through interviews or surveys. We’ll help you figure out which one actually answers your question on the discovery call.',
  },
  {
    q: 'Do you only cover Nigeria?',
    a: 'No. Nigeria is where our fieldwork team is based, but we cover other African markets too, scoped on the discovery call depending on what you need.',
  },
  {
    q: 'Can this be delivered as something we can hand to investors?',
    a: 'Yes. Findings are written up as a proper report by the same team that ran the research, not handed off to a separate writer who has to be re-briefed from scratch.',
  },
];
---
<BaseLayout
  title="Industry Analysis & Market Surveys for African Markets"
  description="Masy Consulting delivers market entry research, industry reports, and custom surveys for businesses making a real decision about an African market, sized and priced for SMEs, not multinationals."
  ogImage="/three.jpg"
>
  <section class="hero-split grid md:grid-cols-2 min-h-[420px] md:min-h-[600px]">
    <div class="bg-indigo text-white flex flex-col justify-center px-6 sm:px-11 md:px-16 py-14 md:py-0 relative overflow-hidden">
      <div class="hero-glow absolute -top-28 -right-28 w-[320px] h-[320px] rounded-full pointer-events-none"></div>
      <p class="relative font-mono text-[12.5px] font-semibold uppercase tracking-[0.06em] text-orange-light mb-5 flex items-center gap-2.5">
        <span class="w-5 h-px bg-current inline-block"></span>
        Industry Analysis & Market Research
      </p>
      <h1 class="relative font-display font-extrabold text-[clamp(2rem,4vw,3rem)] leading-[1.1] tracking-[-0.03em] mb-5 max-w-[480px]">
        Decisions backed by <span class="text-orange-light">real data</span>, not guesswork.
      </h1>
      <p class="relative text-[#C6BEEF] text-[16.5px] max-w-[440px] mb-8">
        Market sizing, competitive landscapes, and hands-on fieldwork on any sector in Africa. If the data doesn't exist yet, we go get it ourselves.
      </p>
      <div class="relative flex gap-4 flex-wrap">
        <Button href="/contact/" variant="primary">Book a discovery call</Button>
        <Button href="/contact/" variant="outlineDark">WhatsApp us</Button>
      </div>
    </div>
    <div class="relative min-h-[280px] md:min-h-0">
      <img
        src="/three.jpg"
        alt="A consultant reviewing and stamping documents by a window with a city view"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0" style="background: linear-gradient(200deg, rgba(20,10,69,0.05) 0%, rgba(20,10,69,0.4) 100%);"></div>
      <div class="seam-badge absolute z-[3] bg-white rounded-[12px] px-5 py-4 flex items-center gap-3.5 shadow-[0_26px_50px_-22px_rgba(20,10,69,0.4)]">
        <span class="font-mono font-bold text-[24px] text-indigo shrink-0">2</span>
        <span class="w-px h-[30px] bg-ink/10 shrink-0"></span>
        <p class="text-[12.5px] text-slate leading-[1.3] max-w-[170px]">Research tracks: desk analysis and primary fieldwork, scoped to what your decision actually needs.</p>
      </div>
    </div>
  </section>

  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 py-7 border-t border-b border-ink/10">
      {facts.map((fact) => (
        <div>
          <h4 class="text-[12px] font-bold uppercase tracking-[0.05em] text-indigo mb-1.5">{fact.label}</h4>
          <p class="text-[14px] text-slate leading-relaxed">{fact.body}</p>
        </div>
      ))}
    </div>
  </div>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="01" label="What's included" count="01 / 04" />
      <div class="mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          From existing data to original fieldwork.
        </h2>
        <p class="mt-4 text-[15.5px] text-slate max-w-xl leading-relaxed text-pretty">
          Most research providers at this price point only do desk research. We do that, plus the fieldwork, when you need data nobody else has.
        </p>
      </div>
      <IconCardGrid items={included} columns={3} />
    </div>
  </section>

  <section class="relative bg-paper-2 py-20 sm:py-28 overflow-hidden">
    <div class="section-accent absolute pointer-events-none"></div>
    <div class="max-w-content mx-auto px-5 sm:px-8 relative">
      <Marker idx="02" label="Who this is for" count="02 / 04" />
      <div class="mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          If any of this sounds familiar.
        </h2>
      </div>
      <PersonaGrid items={whoFor} />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="03" label="How it works" count="03 / 04" />
      <div class="mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.8rem,3.8vw,2.7rem)] leading-[1.08] tracking-[-0.02em] text-ink max-w-2xl text-balance">
          Four steps, start to finish.
        </h2>
      </div>
      <ProcessCards steps={steps} />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <Marker idx="04" label="FAQ" count="04 / 04" />
      <div class="text-center max-w-[640px] mx-auto mb-10" data-reveal>
        <h2 class="font-display font-bold text-[clamp(1.7rem,3vw,2.3rem)] text-ink">
          Questions people ask before booking a call.
        </h2>
      </div>
      <FaqCards items={faqs} />
    </div>
  </section>

  <CTASection
    heading="Back your next decision with real data."
    body="Book a discovery call, or message us on WhatsApp, whichever's easier."
    primaryLabel="Book a discovery call"
    secondaryLabel="WhatsApp us"
    secondaryHref="/contact/"
  />
</BaseLayout>

<style>
  .bg-paper-2 {
    background: #f7f5f0;
  }
  .hero-glow {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
  }
  .seam-badge {
    top: -24px;
    left: 24px;
    animation: cardIn 0.7s var(--ease-out-expo) 0.55s both;
  }
  @media (min-width: 768px) {
    .seam-badge {
      top: 44px;
      left: -26px;
    }
  }
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .section-accent {
    top: -140px;
    right: 8%;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(40, 19, 152, 0.06) 0%, transparent 70%);
  }
  @media (prefers-reduced-motion: reduce) {
    .seam-badge {
      animation: none;
      opacity: 1;
    }
  }
</style>
