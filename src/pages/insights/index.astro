---
import '@fontsource-variable/source-serif-4';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const [featured, ...rest] = posts;

const cardShadow = 'shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(15,15,15,0.12)]';
const cardShadowHover = 'hover:shadow-[0_4px_14px_rgba(15,15,15,0.06),0_24px_44px_-18px_rgba(15,15,15,0.18)]';
---
<BaseLayout
  title="Insights"
  description="Sharp, insight-first thinking on team management, business writing, and market intelligence for African businesses and diaspora entrepreneurs. The thinking we bring to every client."
>
  <section class="max-w-content mx-auto px-5 sm:px-8 pt-8 sm:pt-12 pb-8 sm:pb-10">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b border-line pb-6">
      <div>
        <Eyebrow>Insights</Eyebrow>
        <h1 class="mt-3 font-editorial font-medium text-[clamp(1.8rem,3.2vw,2.6rem)] leading-[1.15] tracking-[-0.01em] text-ink min-h-[1.15em] text-balance">
          <span id="insightsTypeContent"></span><span class="type-cursor" id="insightsTypeCursor"></span>
        </h1>
      </div>
      <p class="text-[14px] text-slate leading-relaxed max-w-sm text-pretty">
        The same thinking we bring to every client, free to read before you ever book a call.
      </p>
    </div>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 pb-20 sm:pb-28">
    {featured && (
      <a
        href={`/insights/${featured.slug}/`}
        class="group flex flex-col md:flex-row bg-ink rounded-xl overflow-hidden mb-5 transition-all duration-300 ease-out-quart hover:-translate-y-1 shadow-[0_2px_8px_rgba(15,15,15,0.08),0_20px_44px_-16px_rgba(15,15,15,0.35)] hover:shadow-[0_4px_14px_rgba(15,15,15,0.1),0_32px_56px_-18px_rgba(15,15,15,0.45)]"
        data-reveal
      >
        <div class="flex-1 p-8 sm:p-12 flex flex-col justify-center min-w-0 order-2 md:order-1">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-6">
            <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.16em] text-orange-light">
              {featured.data.pillar}
            </span>
            <span class="text-white/25" aria-hidden="true">·</span>
            <span class="text-[12.5px] text-white/50">{fmt(featured.data.date)} · {featured.data.readMinutes} min read</span>
          </div>
          <h2 class="font-editorial font-medium text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.2] tracking-[-0.005em] text-white mb-4 text-balance">
            {featured.data.title}
          </h2>
          <p class="font-editorial italic text-[16.5px] sm:text-[17.5px] text-white/70 leading-relaxed mb-8 text-pretty">
            {featured.data.dek}
          </p>
          <span class="inline-flex items-center gap-2 self-start bg-orange text-ink px-5 py-3 rounded-lg font-extrabold text-[12.5px] uppercase tracking-[0.06em] transition-colors duration-300 group-hover:bg-orange-light">
            Read the piece
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300 ease-out-quart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12H20M20 12L13.5 5.5M20 12L13.5 18.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
        <div class="md:w-[46%] aspect-[4/3] md:aspect-square shrink-0 overflow-hidden order-1 md:order-2">
          <img
            src={featured.data.image}
            alt={featured.data.imageAlt}
            class="w-full h-full object-cover object-top transition-transform duration-500 ease-out-quart group-hover:scale-[1.04]"
            loading="eager"
            decoding="async"
          />
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="grid sm:grid-cols-2 gap-5" data-reveal-stagger>
        {rest.map((post) => (
          <a
            href={`/insights/${post.slug}/`}
            class:list={['group flex flex-col bg-white rounded-xl border border-ink/[0.06] overflow-hidden transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:border-ink/[0.12]', cardShadow, cardShadowHover]}
          >
            <div class="aspect-[16/11] overflow-hidden bg-ink/5">
              <img
                src={post.data.image}
                alt={post.data.imageAlt}
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out-quart group-hover:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-7 flex flex-col flex-1">
              <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.16em] text-orange-deep mb-3">
                {post.data.pillar}
              </span>
              <h3 class="font-editorial font-medium text-[20px] leading-[1.32] tracking-[-0.002em] text-ink group-hover:text-indigo transition-colors duration-300 mb-2.5 text-balance">
                {post.data.title}
              </h3>
              <p class="text-[14px] text-slate leading-relaxed mb-5 flex-1 text-pretty">
                {post.data.dek}
              </p>
              <div class="flex items-center justify-between gap-3 pt-4 border-t border-line text-[12px] text-slate/60">
                <span>{fmt(post.data.date)} · {post.data.readMinutes} min read</span>
                <svg class="w-4 h-4 text-ink shrink-0 group-hover:translate-x-1 transition-transform duration-300 ease-out-quart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 12H20M20 12L13.5 5.5M20 12L13.5 18.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <CTASection
    heading="Read something useful. Then, if it's relevant, let's talk."
    body="No pressure, no funnel. Insight first, always. The door's open when you're ready."
  />
</BaseLayout>

<style>
  .type-cursor {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    background: #4d148c;
    margin-left: 3px;
    vertical-align: -0.1em;
    animation: blink 0.85s steps(1) infinite;
  }
  .type-cursor.done {
    opacity: 0;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.insights-quill-wrap) {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: #4d148c;
    font-weight: 500;
  }
  :global(.insights-quill-underline) {
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 12px;
    overflow: visible;
    pointer-events: none;
  }
  :global(.insights-quill-underline path) {
    fill: none;
    stroke: #4d148c;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.insights-quill-underline.draw path) {
    stroke-dashoffset: 0;
  }
</style>

<script>
  type TypeSegment = { text: string; em: boolean };

  function runTypewriter(target: HTMLElement, cursor: HTMLElement, segments: TypeSegment[]) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      segments.forEach((seg) => {
        if (seg.em) {
          const wrap = document.createElement('span');
          wrap.className = 'insights-quill-wrap';
          wrap.textContent = seg.text;
          target.appendChild(wrap);
        } else {
          target.appendChild(document.createTextNode(seg.text));
        }
      });
      cursor.classList.add('done');
      return;
    }

    let segIdx = 0;
    let charIdx = 0;
    let currentEl: HTMLElement | null = null;
    let emTarget: HTMLElement | null = null;

    function step() {
      if (segIdx >= segments.length) {
        cursor.classList.add('done');
        const quillWrap = target.querySelector<HTMLElement>('.insights-quill-wrap');
        if (quillWrap) {
          const ns = 'http://www.w3.org/2000/svg';
          const svg = document.createElementNS(ns, 'svg');
          svg.setAttribute('class', 'insights-quill-underline');
          svg.setAttribute('viewBox', '0 0 140 14');
          svg.setAttribute('preserveAspectRatio', 'none');
          const path = document.createElementNS(ns, 'path');
          path.setAttribute('d', 'M2,10 C30,2 90,14 138,4');
          svg.appendChild(path);
          quillWrap.appendChild(svg);
          setTimeout(() => svg.classList.add('draw'), 150);
        }
        return;
      }
      const seg = segments[segIdx];
      if (charIdx === 0) {
        currentEl = document.createElement('span');
        if (seg.em) {
          currentEl.className = 'insights-quill-wrap';
          const inner = document.createElement('em');
          inner.style.fontStyle = 'italic';
          currentEl.appendChild(inner);
          emTarget = inner;
        }
        target.appendChild(currentEl);
      }
      if (seg.em && emTarget) {
        emTarget.textContent += seg.text[charIdx];
      } else if (currentEl) {
        currentEl.textContent += seg.text[charIdx];
      }
      charIdx++;
      if (charIdx >= seg.text.length) {
        segIdx++;
        charIdx = 0;
      }
      setTimeout(step, 28 + Math.random() * 30);
    }
    setTimeout(step, 300);
  }

  (() => {
    const target = document.getElementById('insightsTypeContent');
    const cursor = document.getElementById('insightsTypeCursor');
    if (!target || !cursor) return;

    runTypewriter(target, cursor, [
      { text: 'See how we think. ', em: false },
      { text: "Then let's talk.", em: true },
    ]);
  })();
</script>
