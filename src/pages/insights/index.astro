---
import '@fontsource-variable/source-serif-4';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const [featured, ...rest] = posts;

const cardShadow = 'shadow-[0_2px_8px_rgba(15,15,15,0.04),0_12px_32px_-16px_rgba(15,15,15,0.12)]';
const cardShadowHover = 'hover:shadow-[0_4px_14px_rgba(15,15,15,0.06),0_24px_44px_-18px_rgba(15,15,15,0.18)]';
---
<BaseLayout
  title="Insights"
  description="Sharp, insight-first thinking on team management, business writing, and market intelligence for African businesses and diaspora entrepreneurs. Real lessons, never a sales pitch."
>
  <section class="max-w-content mx-auto px-5 sm:px-8 pt-12 sm:pt-20 pb-14 sm:pb-16">
    <Eyebrow>Insights</Eyebrow>
    <h1 class="mt-7 font-editorial font-medium text-[clamp(2.3rem,5.4vw,4.2rem)] leading-[1.08] tracking-[-0.01em] text-ink max-w-4xl text-balance">
      Things worth knowing
      <span class="text-indigo italic">before you call us.</span>
    </h1>
    <p class="mt-8 text-[16.5px] text-slate leading-relaxed max-w-2xl text-pretty" data-reveal>
      Every piece here has to clear one bar: would it teach a business owner
      something real, even if they never book a call? If it doesn't, we don't
      publish it.
    </p>
  </section>

  <section class="max-w-content mx-auto px-5 sm:px-8 pb-20 sm:pb-28">
    {featured && (
      <a
        href={`/insights/${featured.slug}/`}
        class:list={['group flex flex-col md:flex-row bg-white rounded-xl border border-ink/[0.06] overflow-hidden mb-5 transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:border-ink/[0.12]', cardShadow, cardShadowHover]}
        data-reveal
      >
        <div class="md:w-[42%] aspect-[4/3] md:aspect-square shrink-0 overflow-hidden bg-ink/5">
          <img
            src={featured.data.image}
            alt={featured.data.imageAlt}
            class="w-full h-full object-cover object-top transition-transform duration-500 ease-out-quart group-hover:scale-[1.04]"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="flex-1 p-8 sm:p-11 flex flex-col justify-center min-w-0">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-6">
            <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.16em] text-orange-deep">
              {featured.data.pillar}
            </span>
            <span class="text-slate/25" aria-hidden="true">·</span>
            <span class="text-[12.5px] text-slate/60">{fmt(featured.data.date)} · {featured.data.readMinutes} min read</span>
          </div>
          <h2 class="font-editorial font-medium text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.2] tracking-[-0.005em] text-ink group-hover:text-indigo transition-colors duration-300 mb-3.5 text-balance">
            {featured.data.title}
          </h2>
          <p class="text-[15.5px] text-slate leading-relaxed mb-7 text-pretty">
            {featured.data.dek}
          </p>
          <span class="inline-flex items-center gap-2 text-[12.5px] font-extrabold uppercase tracking-[0.06em] text-indigo">
            Read the piece
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300 ease-out-quart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12H20M20 12L13.5 5.5M20 12L13.5 18.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="grid sm:grid-cols-2 gap-5" data-reveal-stagger>
        {rest.map((post) => (
          <a
            href={`/insights/${post.slug}/`}
            class:list={['group flex flex-col bg-white rounded-xl border border-ink/[0.06] overflow-hidden transition-all duration-300 ease-out-quart hover:-translate-y-1 hover:border-ink/[0.12]', cardShadow, cardShadowHover]}
          >
            <div class="aspect-[16/11] overflow-hidden bg-ink/5">
              <img
                src={post.data.image}
                alt={post.data.imageAlt}
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out-quart group-hover:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-7 flex flex-col flex-1">
              <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.16em] text-orange-deep mb-3">
                {post.data.pillar}
              </span>
              <h3 class="font-editorial font-medium text-[20px] leading-[1.32] tracking-[-0.002em] text-ink group-hover:text-indigo transition-colors duration-300 mb-2.5 text-balance">
                {post.data.title}
              </h3>
              <p class="text-[14px] text-slate leading-relaxed mb-5 flex-1 text-pretty">
                {post.data.dek}
              </p>
              <div class="flex items-center justify-between gap-3 pt-4 border-t border-line text-[12px] text-slate/60">
                <span>{fmt(post.data.date)} · {post.data.readMinutes} min read</span>
                <svg class="w-4 h-4 text-ink shrink-0 group-hover:translate-x-1 transition-transform duration-300 ease-out-quart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 12H20M20 12L13.5 5.5M20 12L13.5 18.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <CTASection
    heading="Read something useful. Then, if it's relevant, let's talk."
    body="No pressure, no funnel. Insight first, always. The door's open when you're ready."
  />
</BaseLayout>
